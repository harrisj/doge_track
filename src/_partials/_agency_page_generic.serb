{% import 'macros' %}

<div class="mb-10 mt-1">
{% agency = find_agency(id) %}
{%@ 'atoms/agency_title', agency: agency, id: agency.slug %}

{% if agency.linkified_blurb %}
  <div class="my-text">{{ agency.linkified_blurb | md  }}</div>
{% end %}

{% if agency.all_positions.any? %}
<h2 class="mt-4 mb-0 text-lg sm:text-xl md:text-2xl">Positions</h2>

{%@ 'tables/alt_agency_positions', positions: agency.all_positions, agency: agency %}
{% end %}

{% agency_systems = agency.all_systems %}
{% if agency_systems.any? %}
<h2 class="mt-4 mb-0 text-lg sm:text-xl md:text-2xl">Systems</h2>

{%@ 'tables/agency_system_access', govt_systems: agency_systems, agency: agency %}
{% end %}

{% agency_events = agency.all_events || [] %}
{% if agency_events.any? %}
<h2 class="mt-0 mb-0 text-lg sm:text-xl md:text-2xl">Events</h2>

{%@ 'tables/compact_event_timeline', events: agency_events, icon_col: true, agency_col: true %}
{% end %}
</div>

{% open_questions = Question.filter(answer: nil, agency_id: id).all %}
{% if open_questions.any? %}
<h2 class="mt-4 mb-0 text-lg sm:text-xl md:text-2xl">Questions</h2>
  <div class="mt-3">
    {%@ 'questions_list', questions: open_questions %}
  </div>
{% end %}
