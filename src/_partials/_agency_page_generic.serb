{% import 'macros' %}

<div class="mb-10 mt-1">
{% agency = Agency.where(Sequel[id: id] | Sequel[slug: id]).first %}
{% raise "No agency with ID #{id} found" if agency.nil? %}
{%@ Atoms::AgencyTitle agency: agency %}

{% if agency.linkified_blurb %}
  <div class="my-text">{{ agency.linkified_blurb | raw }}</div>
{% end %}

<div class="data-grid">
{%@ Grid::AgencyPositions agency: agency %}
{%@ Grid::AgencySystems agency: agency %}
{%@ Grid::Focused agency: agency %}
</div>
