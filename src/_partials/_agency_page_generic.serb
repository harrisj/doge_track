{% import 'macros' %}

{% agency = find_agency(id) %}
{%@ 'agency_title', agency: agency %}

{% if blurb %}
  <div class="rose prose-sm sm:prose-base md:prose-lg prose-stone prose-li:m-[0.1em] dark:prose-invert">{{ blurb | markdownify }}</div>
{% end %}

{% if agency.positions.any? %}
<h2>Positions</h2>

{%@ 'agency_positions_table', positions: agency.positions %}
{% end %}

{% agency_events = site.data.events.find_all {|e| e.agencies_parents.include? agency.id } %}

{% if agency_events.any? %}
<h2>Events</h2>

{%@ 'event_timeline', events: agency_events %}
{% end %}