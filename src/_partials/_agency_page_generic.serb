{% import 'macros' %}

{% agency = find_agency(id) %}

{%@ "agency_title", agency: agency %}

<div class="tabs tabs-border">
  <input type="radio" name="generic_tabs" class="tab" aria-label="Info" checked="checked" />
  <div class="tab-content bg-base-100">
{%@ "blurb", text: agency.blurb %} 
  </div>

<input type="radio" name="generic_tabs" class="tab" aria-label="People" />
<div class="tab-content bg-base-100">
{% agency_positions = agency.positions %}

{% if agency_positions.any? %}
{%@ 'agency_positions_table', positions: agency_positions %}
{% end %}
</div>

<input type="radio" name="generic_tabs" class="tab" aria-label="Events" />
<div class="tab-content  bg-base-100">
{% agency_events = site.data.events.find_all {|e| e.agencies_parents.include? agency.id } %}

{% if agency_events.any? %}
{%@ 'event_timeline', events: agency_events %}
{% end %}  
</div>

<input type="radio" name="generic_tabs" class="tab" aria-label="Systems" />
<div class="tab-content bg-base-100">
Systems info will go here.
</div>
</div>


