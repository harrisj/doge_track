{% import 'macros' %}

<div class="mb-10 mt-1">
{% agency = find_agency(id) %}
{%@ 'agency_title', agency: agency, id: agency.slug %}

{% if blurb %}
  <div class="prose prose-sm sm:prose-base md:prose-md lg:prose-lg max-w-none prose-stone prose-li:m-[0.1em] dark:prose-invert">{{ blurb | md }}</div>
{% end %}

{% if agency.positions.any? %}
<h2 class="mt-4 mb-0 text-lg sm:text-xl md:text-2xl">Positions</h2>

{%@ 'agency_positions_table', positions: agency.positions, agency: agency %}
{% end %}

{% agency_roles = site.data.system_roles.select {|sr| sr.agency && (sr.agency.id == agency.id || sr.agency.parent_id == agency.id) } || [] %}
{% if agency_roles.any? %}
<h2 class="mt-4 mb-0 text-lg sm:text-xl md:text-2xl">Systems</h2>

{%@ 'agency_system_access_table', roles: agency_roles, agency: agency %}
{% end %}

{% agency_events = site.data.events.find_all {|e| e.agencies_parents.include? agency.id } %}
{% if agency_events.any? %}
<h2 class="mt-0 mb-0 text-lg sm:text-xl md:text-2xl">Events</h2>

{%@ 'compact_event_timeline', events: agency_events, icon_col: true, agency_col: true %}
{% end %}
</div>

{% open_questions = site.data.questions.select {|q| q.agency_id == id && q.answer.blank?} %}
{% if open_questions.any? %}
<h2 class="mt-4 mb-0 text-lg sm:text-xl md:text-2xl">Questions</h2>
  <div class="mt-3">
    {%@ 'questions_list', questions: open_questions %}
  </div>
{% end %}