{% import 'macros' %}
<div class="mb-10 mt-1">
  <div class="flex justify-between sm:justify-start items-end not-prose">
    <div class="flex-none order-last sm:order-first text-lg sm:text-xl md:text-2xl leading-none mb-0 sm:pr-2"><i class="fa-sharp fa-solid {{ person_icon(people[0]) }}"></i></div>
        <div class="flex-none order-first sm:order-1ast"><h2 class="mt-0 mb-0 text-lg sm:text-xl md:text-2xl leading-none font-title">{{ title }}</h2></div>
  </div>
  <div class="sm:ml-7 md:ml-8 lg:ml-9.5 lining-nums">
    <div class="prose prose-sm md:prose-base prose-stone max-w-none prose-li:m-[0.1em] dark:prose-invert mb-2">
      <p class="mb-0 mt-0.5 leading-5 mb-2">{{ content | md }}</p>
    </div>

    {% names = people.map(&:name).compact %}
    {% positions = site.data.positions.select {|x| names.include?(x.name) } %}
    {% if positions.any? %}
      <div class="mt-3">
        <h3 class="mb-0 mt-0 h3">Positions</h3>
        {%@ 'agency_positions_table', positions: positions, agency: nil %}
      </div>
    {% end %}

    {% system_roles = site.data.system_roles.select {|x| names.include?(x.name) } %}
    {% if system_roles.any? %}
      <div class="mt-3">
        <h3 class="mb-0 mt-0 h3">Systems</h3>
        {%@ 'agency_system_access_table', roles: system_roles %}
      </div>
    {% end %}

    {% events = site.data.events.select {|x| (x.names & names).any? } %}
    {% if events.any? %}
    <div class="mt-3">
      <h3 class="mb-0 mt-0 h3">Events</h3>
      {%@ 'compact_event_timeline', agency_col: true, events: events, month_separator: false, show_directories: true, always_show_date: true %}
    </div>
    {% end %}

    {% open_questions = site.data.questions.select {|q| names.include?(q.name) && q.answer.blank?} %}
    {% if open_questions.any? %}
    <div class="mt-3">
      <h3 class="mb-0 mt-0 h3">Open Questions</h3>
      {%@ 'questions_list', questions: open_questions %}
    </div>
    {% end %}
  </div>
</div>