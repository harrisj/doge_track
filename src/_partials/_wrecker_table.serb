{% import "macros" %}

<table class="table table-zebra table-xs sm:table-sm md:table-md lg:table-lg">
  <thead>
    <tr class="text-left">
      <th>Agency</th>
      <th>Name</th>
      <th class="hidden sm:table-cell">Age</th>
      <th>Start</th>
      <th class="hidden md:table-cell">Skill</th>
      <th>Detailed To</th>
    </tr>
  </thead>
  <tbody>
  {% wreckers.sort_by {|x| x.sort_date}.each do |person| %}
    {% details = person.positions.reject {|pos| pos.agency_id == person.start_agency } %}
    <tr class="my-table-sm text-left">
      <td class="align-top">{{ agency_link(person.start_agency) }}</td>
      <td class="align-top">{{ person_link(person.name) }}</td>
      <td class="align-top hidden sm:table-cell">{{ person.age }}</td>
      <td class="align-top">{{ render EdtfFormat.new(person.start_date, :compact, :filled) }}</td>
      <td class="align-top hidden md:table-cell">{{ person_background(person) }}</td>
      <td class="align-top">{{ details | agencies | uniq | agency_links }}</td>
    </tr>
  {% end %}
  </tbody>
</table>