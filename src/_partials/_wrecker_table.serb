{% import "macros" %}

<table class="table is-size-5">
  <thead>
    <tr>
      <th>Name</th>
      <th>Age</th>
      <th>Start Date</th>
      <th>Background</th>
      <th>Detailed To</th>
    </tr>
  </thead>
  <tbody>
  {% wreckers.sort_by {|x| x.sort_date}.each do |person| %}
    {% details = person.positions.select {|pos| pos.type == "detailed" || pos.type == "internal" } %}
    <tr>
      <td>{{ person_link(person.name) }}</td>
      <td>{{ person.age }}</td>
      <td>{{ person.start_date }}</td>
      <td>{% if person.background %}{{ person.background | titleize }}{% end %}</td>
      <td>{{ details | agencies | agency_links }}</td>
    </tr>
  {% end %}
  </tbody>
</table>