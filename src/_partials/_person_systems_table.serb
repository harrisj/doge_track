{% import 'macros' %}

<table class="table table-fixed sm:table-auto table-xs sm:table-sm lg:table-md border-4">
  <thead>
  <tr class="">
    <th class="w-3/12 sm:w-2/12 text-xs">System</th>
    <th class="text-left hidden sm:table-cell text-xs sm:w-1/12">Dates</th>
    <th class="w-9/12 text-left text-xs max-w-auto sm:min-w-auto">Details</th>
  </tr>
  </thead>
  <tbody class="">
    {% roles.each do |role| %}
      {% govt_system = site.data.systems.find {|s| s.id == role.govt_system_id } %}
    <tr class="font-sans" id="{{ role.id }}">
      <td class="align-top">
      {% if govt_system && govt_system.acronym %}<div><abbr title="{{ govt_system.name }}">{{ govt_system.acronym }}</abbr></div>{% end %}
      <div class="sm:hidden">{{ render EdtfFormat.new(role.date_granted, :compact) }}-{{ render EdtfFormat.new(role.date_revoked, :compact) }}</div>
      <div class="sm:hidden">{{ agency_link(role.agency_id) }}</div>
      </td>
      <td class="align-top hidden sm:table-cell py-2">{{ render EdtfFormat.new(role.date_granted, :compact) }}-{{ render EdtfFormat.new(role.date_revoked, :compact) }}</td>
      <td class="align-top font-sans py-2">{%@ 'system_role_summary', role: role %}</td>
    </tr>
    {% end %}
  </tbody>
</table>