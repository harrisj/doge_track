{% import "macros" %}

{% raise "Not passed an event for event_icon: #{event.inspect}" unless event.obj_type == 'Event' %}
<div class="flex">
  <div class="flex-none w-9">
    <i class="fa fa-xl {{ event_icon(event) }}"></i>
  </div>
  <div class="flex-auto no-prose gap-0 pt-1 text-sm">
    <div class="flex flex-wrap content-center">
      <div class="flex-none font-bold">{{ event_title(event) }}</div>
      <div class="flex-none ml-2">{{ event.date }}</div>
      <div class="flex-none ml-2">
        <i class="fas fa-building mr-1"></i>
        {{ event.agency_ids | agencies | agency_links }}
      </div>
      {% if event.source_name %}
      <div class="flex-none ml-2">
        <i class="fas fa-newspaper mr-1"></i>
        <a href="{{ event.source }}">{{ event.source_name }}</a>
      </div>
      {% end %}
        {% if event.names_aliases %}
          {% for person in event.names_aliases %}
            <div class="flex-none ml-2">
              {% if person.alias and person.name %}
                <span class="icon is-small"><i class="fas fa-user"></i></span>
                {{ person_link(person.name) }} ({{ person.alias }})
              {% elsif person.alias %}
                <span class="icon is-small"><i class="fas fa-user-secret"></i></span>
                {{ person.alias }}
              {% else %}
                <span class="icon is-small"><i class="fas fa-user"></i></span>
                {{ person_link(person.name) }}
              {% end %}
            </div>
          {% end %}
        {% end %}
    </div>
    <div class="leading-6">{{ event.text }}</div>
  </div>
</div>

