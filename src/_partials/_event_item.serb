{% import "macros" %}

<li class="list-row">
  <div class="sm:text-2xl md:text-2xl lg:text-3xl xl:text-4xl 2xl:text-5xl align-top"><i class="fa {{ event_icon(event) }}"></i></div>
  <div class="">
    <div class="flex flex-wrap content-center align-top">
      <div class="flex-none font-bold pe-2">{{ event_title(event) }}</div>
      <div class="flex-none pe-2">{{ event.date }}</div>
      <div class="flex-none pe-2">
        <i class="fas fa-building mr-1"></i>
        {{ event.agency_ids | agencies | agency_links }}
      </div>
      {% if event.source_name %}
      <div class="flex-none pe-2">
        <i class="fas fa-newspaper mr-1"></i>
        <a class="link-hover" href="{{ event.source }}">{{ event.source_name }}</a>
      </div>
      {% end %}
        {% if event.names_aliases %}
          {% for person in event.names_aliases %}
            <div class="flex-none pe-2">
              {% if person.alias and person.name %}
                <span class="icon is-small"><i class="fas fa-user"></i></span>
                {{ person_link(person.name) }} ({{ person.alias }})
              {% elsif person.alias %}
                <span class="icon is-small"><i class="fas fa-user-secret"></i></span>
                {{ person.alias }}
              {% else %}
                <span class="icon is-small"><i class="fas fa-user"></i></span>
                {{ person_link(person.name) }}
              {% end %}
            </div>
          {% end %}
        {% end %}
    </div>
    <div class="leading-5 pt-1">{{ event.text }}</div>
  </div>
</li>