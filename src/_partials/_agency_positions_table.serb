{% import "macros" %}

{% macro "pos_type_display" do |pos| 
    case pos.type
    when 'detailed'
      "Detail"
    when 'internal'
      "Transfer"
    when 'appointed'
      "Appointed"
    when 'consultant'
      "Consultant"
    else
      pos.type.titleize
    end
  end
%}

{% macro "pos_notes" do |pos| 
    case pos.type
    when 'detailed'
    when 'consultant'
    when 'appointed'
    when 'internal'
    when 'unknown'
      '(no public details)'
    else
      ''
    end
  end
%}

{% macro "pos_from_to" do |pos|
   if pos.type == 'detailed' && pos.from_agency_id
      "<span class=\"icon-text\"><span class=\"icon\"><i class=\"fa-solid fa-arrow-left\"></i></span> #{ agency_link(pos.from_agency_id) }</span>".html_safe
    elsif pos.type == 'transfer'
      "".html_safe
    else
      ""
   end
  end
%}

<table class="table table-sm">
  <thead>
    <tr>
      <th>Start</th>
      <th>End</th>
      <th>Name</th>
      <th>Type</th>
      <th>Move</th>
      <th>Notes</th>
    </tr>
  </thead>
  <tbody>
  {% positions.sort_by {|p| p.sort_date}.each do |pos| %}
    <tr>
      <td>{{ pos.start_date }}</td>
      <td>{{ pos.end_date }}</td>
      <td>{% if pos.person %}{{ person_link(pos.person) }}{% elsif pos.alias %}<a href="/topics/aliases">{{ pos.alias.id }}</a>{% end %}</td>
      <td>{{ pos_type_display(pos) }}</td>
      <td>{% if pos.from_agency_id %}<span class="icon-text">{{ agency_link(pos.from_agency_id) }} <span class="icon"><i class="fa-solid fa-arrow-right"></i></span> {{ agency_link(pos.agency_id) }}</span>{% end %}</td>
      <td></td>
    </tr>
  {% end %}
  </tbody>
</table>