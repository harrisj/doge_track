{% import "macros" %}

<table class="table table-auto table-xs sm:table-sm lg:table-md border-4 mb-0">
  <thead>
  <tr>
    <th class="text-left hidden sm:table-cell">Date</th>
    <th class="text-left min-width-[104px] sm:w-auto">Position</th>
    <th class="text-left">Person</th>
    <th class="text-left">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% positions.each do |pos| %}
    <tr class="font-mono">
      <td class="align-top hidden sm:table-cell">{% if pos.start_date || pos.end_date %}{{ render EdtfFormat.new(pos.start_date, :compact, :none) }}{%if pos.end_date %}-{{ render EdtfFormat.new(pos.end_date, :compact) }}{% end %}{% end %}</td>
      <td class="align-top min-width-[104px] "><nobr>{{ position_move(pos) }}</nobr>
      <div class="sm:hidden">{% if pos.start_date || pos.end_date %}{{ render EdtfFormat.new(pos.start_date, :compact, :none) }}{%if pos.end_date %}-{{ render EdtfFormat.new(pos.end_date, :compact) }}{% end %}{% end %}</div>
      </td>
      <td class="align-top">{% if pos.person %}{{ person_link(pos.person) }}{% elsif pos.alias %}<a href="/topics/aliases">{{ doge_alias(pos.alias) }}</a>{% end %}</td>
      <td class="align-top">{{ position_summary(pos) | md }}</td>
    </tr>
    {% end %}
  </tbody>
</table>