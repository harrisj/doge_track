{% import 'macros' %}

{% grouped_positions = positions.group_by(&:sort_parent_agency)
   grouped_positions.values.each {|positions| positions.sort_by! {|pos| pos.sort_date}}
%}

<table class="my-table-style">
  <thead>
  <tr class="">
    <th class="text-left my-2col-table-col1">Position</th>
    <th class="text-left my-2col-table-col2">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% grouped_positions.values.sort_by { |positions| [positions[0].sort_date, positions[0].agency_id] }.each do |positions| %}
      {% sources = positions.map(&:sources).flatten.compact.uniq %}
      {% if positions&.last&.end_date
            last_position = positions.last
            end_date = last_position.end_date
         end
       %}
       {% agency = positions[0].agency %}
      <tr>
        <td class="align-top">{%@ Atoms::AgencyLink agency %}</td>
        <td class="align-top">
          {%@ Atoms::SourceBox sources: sources %}
          <div class="flex flex-col space-y-1">
          {% positions.each do |pos| %}
            <div>{%@ Atoms::PositionMoveLabel position: pos, show_dest: true %}{% if pos.start_date %} {%@ Atoms::DateRange start_date: pos.start_date, end_date: pos.end_date %}{% else %} <em>date unknown</em>{% end %} {%@ Molecules::PositionSummary position: pos, agency: agency %}</div>
          {% end %}
          {% if last_position && last_position.end_date.to_s =~ /^\d{4}-\d{2}-\d{2}$/ %}
            <div><i class="my-emphasis fa-sharp fa-solid fa-left-from-bracket"></i> {%@ Atoms::PositionEndTypeLabel position: last_position %} <span class="my-date">{%@ Atoms::DateLabel last_position.end_date %}</span></div>
          {% end %}
          </div>
        </td>
      </tr>
    {% end %}
  </tbody>
</table>
