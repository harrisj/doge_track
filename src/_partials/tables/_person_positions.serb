{% import 'macros' %}

<table class="table table-fixed sm:table-auto table-xs sm:table-sm lg:table-md border-4">
  <thead>
  <tr class="">
    <th class="w-3/12 sm:w-2/12 text-xs">Position</th>
    <th class="text-left hidden sm:table-cell text-xs sm:w-2/12">Dates</th>
    <th class="w-8/12 text-left text-xs max-w-auto sm:min-w-auto">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% positions.each do |pos| %}
    <tr class="font-sans" id="{{ pos.id }}">
      <td class="align-top"><div class="sm:inline-block>{%@ 'atoms/position_move_label', position: pos %}</div>
        <div class="sm:hidden">
          {%@ 'atoms/date_range_label', first: pos.start_date, last: pos.end_date %}
          {% if pos.end_date && position_end_type(pos) %}<div>{% if pos.person && !pos.person.govt_exit_date.nil? %}<strong>Left DOGE</strong>{% else %}{{ position_end_type(pos) | raw }}{% end %}</div>{% end %}
        </div>    
      </td>
      <td class="align-top hidden sm:table-cell">
        {%@ 'atoms/date_range_label', first: pos.start_date, last: pos.end_date %}
        {% if pos.end_date && position_end_type(pos) %}<div>{% if pos.person && !pos.person.govt_exit_date.nil? %}<strong>Left DOGE</strong>{% else %}{{ position_end_type(pos) | raw }}{% end %}</div>{% end %}
      </td>
      <td class="align-top">{%@ 'molecules/position_summary', position: pos %}</td>
    </tr>
    {% end %}
  </tbody>
</table>