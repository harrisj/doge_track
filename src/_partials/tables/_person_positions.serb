{% import 'macros' %}

<table class="my-table-style">
  <thead>
  <tr class="">
    <th class="text-left my-3col-table-col1">Position</th>
    <th class="text-left my-3col-table-col2">Dates</th>
    <th class="text-left my-3col-table-col3">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% positions.each do |pos| %}
    <tr class="font-sans" id="{{ pos.id }}">
      <td class="align-top"><div class="inline-block">{%@ 'atoms/position_move_label', position: pos %}</div>
        <div class="only-mobile">
          {%@ 'atoms/date_range_label', first: pos.start_date, last: pos.end_date %}
          {%@ 'atoms/doge_exit_label', position: pos %}
        </div>    
      </td>
      <td class="align-top hide-cell-mobile">
        {%@ 'atoms/date_range_label', first: pos.start_date, last: pos.end_date %}
        {%@ 'atoms/doge_exit_label', position: pos %}
      </td>
      <td class="align-top">{%@ 'molecules/position_summary', position: pos %}</td>
    </tr>
    {% end %}
  </tbody>
</table>