{% import 'macros' %}

<table class="my-table-style">
  <thead>
  <tr class="">
    <th class="text-left my-2col-table-col1">System</th>
    <th class="text-left my-2col-table-col2">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% roles.each do |role| %}
      {% govt_system = role.govt_system %}
    <tr class="font-sans" id="{{ role.id }}">
      <td class="align-top my-2col-table-col1">
      {% if govt_system %}<div>{% if govt_system.acronym %}<abbr title="{{ govt_system.name }}">{{ govt_system.acronym }}</abbr>{% else %}{{ govt_system.name }}{% end %}</div>{% end %}
      {% if role.agency_id %}<div>{%@ Atoms::AgencyLink role.agency_id %}</div>{% end %}
      </td>
      <td class="align-top my-2col-table-col2">
        {%@ Atoms::SourceBox sources: role.sources %}
        {%@ 'molecules/person_system_role_summary', role: role %}</td>
    </tr>
    {% end %}
  </tbody>
</table>
