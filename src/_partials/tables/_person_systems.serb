{% import 'macros' %}

<table class="table table-fixed sm:table-auto table-xs sm:table-sm lg:table-md border-4">
  <thead>
  <tr class="">
    <th class="text-left my-3col-table-col1">System</th>
    <th class="text-left my-3col-table-col2">Dates</th>
    <th class="text-left my-3col-table-col3">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% roles.each do |role| %}
      {% govt_system = site.data.systems.find {|s| s.id == role.govt_system_id } %}
    <tr class="font-sans" id="{{ role.id }}">
      <td class="align-top my-3col-table-col1">
      {% if govt_system %}<div>{% if govt_system.acronym %}<abbr title="{{ govt_system.name }}">{{ govt_system.acronym }}</abbr>{% else %}{{ govt_system.name }}{% end %}</div>{% end %}
      <div class="sm:hidden">{%@ 'atoms/date_range_label', first: role.date_granted, last: role.date_revoked %}</div>
      <div>{{ agency_link(role.agency_id) }}</div>
      </td>
      <td class="align-top my-3col-table-col2">{%@ 'atoms/date_range_label', first: role.date_granted, last: role.date_revoked %}</td>
      <td class="align-top my-3col-table-col3">{%@ 'molecules/system_role_summary', role: role %}</td>
    </tr>
    {% end %}
  </tbody>
</table>