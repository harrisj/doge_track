{% import "macros" %}

<table class="table table-xs sm:table-sm md:table-md table-zebra">
  <thead>
    <tr class="text-left">
      <th>Agency</th>
      <th>Name</th>
      <th class="hidden sm:table-cell">Age</th>
      <th>Start</th>
      <th class="hidden md:table-cell">Skill</th>
      <th>Detailed To</th>
    </tr>
  </thead>
  <tbody>
  {% wreckers.sort_by {|x| x.sort_date}.each do |person| %}
    <tr class="my-table-sm text-left">
      <td class="align-top">{%@ Atoms::AgencyLink person.positions[0].from_agency_id %}</td>
      <td class="align-top">{%@ Atoms::PersonLink person.name %}</td>
      <td class="align-top hidden sm:table-cell">{{ person.age }}</td>
      <td class="align-top"><span class="my-date">{{ render EdtfFormat.new(person.start_date, :compact_year, :filled) }}</span></td>
      <td class="align-top hidden md:table-cell">{{ person_skill(person) }}</td>
      <td class="align-top">{{ person.positions | agencies | uniq | agency_links }}</td>
    </tr>
  {% end %}
  </tbody>
</table>
