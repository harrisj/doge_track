{% all_positions = agency.all_positions_and_details_out
   grouped_positions = all_positions.group_by {|pos| pos.sort_name }
   grouped_positions.values.each {|positions| positions.sort_by! {|pos| pos.sort_date}}
%}

{%@ 'atoms/legend_header' %}
<table class="my-table-style">
  <thead>
  <tr>
    <th class="text-left my-2col-table-col1">Name</th>
    <th class="text-left my-2col-table-col2">Positions</th>
  </tr>
  </thead>
  <tbody>
    {% grouped_positions.values.sort_by { |positions| [positions[0].sort_date, positions[0].sort_name] }.each do |positions| %}
      {% sources = positions.map(&:sources).flatten.compact.uniq.sort_by(&:sort_date) %}
      {% person = positions[0].person %}
      {% doge_alias = positions[0].doge_alias %}
      {% start_date = positions[0].start_date %}
      {% agency_positions = positions.filter { |pos| pos.agency_id == agency.id }.sort_by { |pos| pos.sort_date } %}
      {% if agency_positions&.last&.end_date
            last_position = agency_positions.last
            end_date = last_position.end_date
         elsif person&.govt_exit_date
            end_date = person.govt_exit_date
         end
       %}
      <tr>
        <td class="align-top">{%@ 'atoms/position_person_link', position: positions[0] %}</td>
        <td class="align-top">
          {%@ 'atoms/float_source_box', sources: sources %}
          <div class="flex flex-col space-y-1">
          {% positions.each do |pos| %}
            <div>{%@ 'atoms/agency_position_move_label', position: pos, agency: agency %}{% if pos.start_date %} {%@ 'atoms/date_range_label', first: pos.start_date, last: pos.end_date %}{% else %} <em>date unknown</em>{% end %} {%@ 'molecules/alt_position_summary', position: pos, agency: agency %}</div>
          {% end %}
          {% if person&.govt_exit_date %}
          <div class="font-semibold"><span class="text-base-content/75"><i class="fa-sharp fa-solid fa-left-from-bracket"></i> Left govt</span> <span class="my-date">{{ render EdtfFormat.new(person.govt_exit_date, :compact_year, :none) }}</span> ({{ person.govt_exit_truth }})</div>
          {% elsif last_position && last_position.end_date.to_s =~ /^\d{4}-\d{2}-\d{2}$/ %}
          <div><i class="my-emphasis fa-sharp fa-solid fa-left-from-bracket"></i> {{ position_end_type(last_position) | raw }} <span class="my-date">{{ render EdtfFormat.new(last_position.end_date, :compact_year, :none) }}</span></div>
          {% end %}
          </div>
        </td>
      </tr>
    {% end %}
  </tbody>
</table>
