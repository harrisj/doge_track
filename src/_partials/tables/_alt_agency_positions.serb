{% all_positions = agency.all_positions_and_details_out
   grouped_positions = all_positions.group_by {|pos| pos.sort_name }
   grouped_positions.values.each {|positions| positions.sort_by! {|pos| pos.sort_date}}
%}
<table class="my-table-style">
  <thead>
  <tr>
    <th class="text-left my-3col-table-col1">Name</th>
    <th class="text-left my-3col-table-col2">Date</th>
    <th class="text-left my-3col-table-col3">Positions</th>
  </tr>
  </thead>
  <tbody>
    {% grouped_positions.values.sort_by { |positions| [positions[0].sort_date, positions[0].sort_name] }.each do |positions| %}
      {% person = positions[0].person %}
      {% doge_alias = positions[0].doge_alias %}
      {% start_date = positions[0].start_date %}
      {% agency_positions = positions.filter { |pos| pos.agency_id == agency.id }.sort_by { |pos| pos.sort_date } %}
      {% if agency_positions&.last&.end_date
            last_position = agency_positions.last
            end_date = last_position.end_date
         elsif person&.govt_exit_date
            end_date = person.govt_exit_date
         end
       %}
      <tr>
        <td class="align-top">{%@ 'atoms/position_person_link', position: positions[0] %}
        <div class="only-mobile">{%@ 'atoms/date_range_label', first: start_date, last: end_date %}</div>
        </td>
        <td class="align-top hide-cell-mobile">{%@ 'atoms/date_range_label', first: start_date, last: end_date %}</td>
        <td class="align-top">
          <div class="flex flex-col space-y-1">
          {% positions.each do |pos| %}
            <div class="-indent-4">{%@ 'atoms/agency_position_move_label', position: pos, agency: agency %}{% if pos.start_date %} {%@ 'atoms/date_range_label', first: pos.start_date, last: pos.end_date %}{% end %} {%@ 'molecules/alt_position_summary', position: pos, agency: agency %}</div>
          {% end %}
          {% if person&.govt_exit_date %}
          <div class="-indent-4"><i class="fa-sharp fa-solid fa-left-from-bracket"></i> <strong>Left DOGE</strong> {{ render EdtfFormat.new(person.govt_exit_date, :compact, :none) }}</div>
          {% elsif last_position %}
          <div class="-indent-4"><i class="fa-sharp fa-solid fa-left-from-bracket"></i> {{ position_end_type(last_position) | raw }} {{ render EdtfFormat.new(last_position.end_date, :compact, :none) }}</div>
          {% end %}
          </div>
        </td>
      </tr>
    {% end %}
  </tbody>
</table>
