{% grouped_details = agency.details_from.group_by {|pos| pos.person.sort_name } %}
<table class="my-table-style">
  <thead>
  <tr>
    <th class="text-left my-2col-table-col1">Name</th>
    <th class="text-left my-2col-table-col2">Details</th>
  </tr>
  </thead>
  <tbody>
  {% grouped_details.each do |sort_name, positions| %}
        <tr>
        <td class="align-top">{{ person_link(positions[0].person ) }}</td>
        <td class="align-top">{% positions.sort_by {|pos| pos.start_date || '2029-01-20' }.each_with_index do |pos, i| %}
          {% if i > 0 %}, {% end %}{{ agency_link(pos.agency) }}{% if pos.start_date %} ({%@ Atoms::DateRange start_date: pos.start_date, end_date: pos.end_date %}){% end %}
        {% end %}</td>
      </tr>
  {% end %}
  </tbody>
</table>
