
<table class="my-table-style">
<thead>
  <tr>
    <th class="text-left my-2col-table-col1">Name</th>
    <th class="text-left my-2col-table-col2">Description</th>
  </tr>
</thead>
<tbody>
{% systems.each do |govt_system| %}
  {% roles = govt_system.system_roles %}
  {% next unless roles.any? %}
  <tr>
    <td class="align-top my-2col-table-col1">
      {% if govt_system.acronym %}<div><a class="link-hover" href="/all/systems#{{ govt_system.id }}">{{ govt_system.acronym }}</a></div>{% end %}
      <div>
      {% if govt_system.type == 'ssp' %}
        <abbr title="Shared Service Provider">SSP</abbr>
      {% elsif govt_system.type == 'saas' %}
        <abbr title="Software as a Service">SaaS</abbr>
      {% elsif govt_system.agency_id %}
        {{ agency_link(govt_system.agency_id) }}
      {% end %}</div>
    </td>
    <td class="align-top my-2col-table-col2">
      <div><a class="link-hover" href="/all/systems#{{ govt_system.id }}">{{ govt_system.name }}</a></div>
      <div class="italic">{{ govt_system.description }}</div>

      <div class="flex flex-col">
        {% roles.each do |role| %}
        <div>
          {% if govt_system.type == 'ssp' || govt_system.type == 'saas' %}
              {{ agency_link(role.agency_id) }}:
          {% end %}
          {% if role.name %}{%@ Atoms::PersonLink role.name %}{% elsif role.doge_alias_id %}{{ alias_link(role.doge_alias_id) }}{% end %}
          ({%@ Atoms::DateRange start_date: role.date_granted, end_date: role.date_revoked, always_dash: true %}{% if role.type != 'read' && role.type != 'unknown' %}, {%@ 'system_access_type', role: role %} access{% end %})
      </div>
      {% end %}
    </div>
    </td>
  </tr>
{% end %}
</tbody>
</table>
