{% 
require 'edtf'
import 'macros'

icon_col = true if icon_col.nil?
month_separator = true if month_separator.nil?
show_directories = true if show_directories.nil?
%}
 
 {% if events.any? %}
 {% prior_row_date = Date.edtf!(events[0].date)-1 %}

<table class="my-table-style mb-0 mt-0">
  <thead>
    <tr>
      <th class="my-3col-table-col1">Agency</th>
      <th class="my-3col-table-col2">Date</th>
      <th class="my-3col-table-col3">Event</th>
    </tr>
  </thead>
  <tbody>
  {% events.each do |event| %}
    {% parsed_date = Date.edtf(event.date) %}
    {% if month_separator && parsed_date.month > prior_row_date.month %}
    <tr>
      <td class="text-center font-bold italic" colspan="100%">{{ parsed_date.strftime("%B %Y") }}</td>
    </tr>
    {% end %}
    <tr class="font-sans" id="{{ event.id }}">
      <td class="align-top">
        <div class="only-mobile">{{ render EdtfFormat.new(event.date, :compact) }}</div>
        <div>{{ event.agencies | agency_links }}</div>
      </td>
      <td class="align-top hide-cell-mobile">
        {{ render EdtfFormat.new(event.date, :compact) }}
        {% prior_row_date = parsed_date %}
      </td>
      <td class="align-top">
        <div class="font-sans">
        {% if icon_col %}<div class="inline"><i class="fa-sharp fa-solid {{ event_icon(event.type) }}"></i> <span class="hidden md:inline font-bold">{{ event_title(event.type) }}: </span></div>{% end %}
        {{ event.linkified_text | raw }}
        {% if event.fuzz %} <span class="italic">(fuzz: {{ event.fuzz | md | strip_p }})</span>{% end %}
        {% questions_str = question_links(event)%}
        {% if questions_str %}{{ questions_str | raw }}{% end %}
        {% if event.type == 'interagency' && event.names_aliases.any? %}
              {% event.names_aliases.group_by(&:category).sort_by {|c, p| p.size}.reverse.each do |category, people| %}
                {% if category == 'alias' %}
                  <div><i class="fa-sharp fa-solid fa-user-secret"></i> {{ people.map(&:alias) | alias_links }}</div>
                {% else %}
                  <div><i class="fa-sharp fa-solid {{ person_icon(people.first) }}"></i> {{ people.map(&:name) | people_links }}</div>
                {% end %}
              {% end %}
        {% end %}
        {% if show_directories && event.type == 'directory' %}
            {% event.names_aliases.group_by(&:category).sort_by {|c, p| p.size}.reverse.each do |category, people| %}
              {% if category == 'alias' %}
                <div><i class="fa-sharp fa-solid fa-user-secret"></i> {{ people.map(&:alias) | alias_links }}</div>
              {% else %}
                <div><i class="fa-sharp fa-solid {{ person_icon(people.first) }}"></i> {{ people.map(&:name) | people_links }}</div>
              {% end %}
            {% end %}
        {% end %}

        {% if event.source && event.source_name %} <div class="text-nowrap float-right pl-4"><a href="{{ event.source }}" class="link-hover"><i class="fa-sharp fa-solid fa-link-simple"></i>&nbsp;<span class="italic text-2xs sm:text-xs">{{ event.source_name }}</span></a></div>{% end %}
        </div>
      </td>
    </tr>
  {% end %}
  </tbody>
</table>
{% end %}