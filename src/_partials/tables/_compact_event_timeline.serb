{%
require 'edtf'
import 'macros'

icon_col = true if icon_col.nil?
month_separator = true if month_separator.nil?
show_directories = true if show_directories.nil?
show_projects = false if show_projects.nil?
my_agency = nil unless my_agency
%}

{% if events && events.any? %}
{% events = events.sort_by! {|e| e.date.to_s } %}
{% prior_row_date = events[0].date-1 %}

<table class="my-table-style mb-0 mt-0">
  <thead>
    <tr>
      <th class="my-2col-table-col1">Date</th>
      <th class="my-2col-table-col2">Event</th>
    </tr>
  </thead>
  <tbody>
  {% events.each do |event| %}
    {% if month_separator && (event.date.strftime("%Y-%m") > prior_row_date.strftime("%Y-%m")) %}
    <tr>
      <td class="text-center font-bold italic bg-base-300" colspan="100%">{{ event.date.strftime("%B %Y") }}</td>
    </tr>
    {% end %}
    <tr class="font-sans" id="{{ event.id }}">
    {% prior_row_date = event.date %}
      <td class="align-top border-base-300">
          <div class="my-date">{{ render EdtfFormat.new(event.date, :compact_year) }}</div>
          {% if my_agency.nil? || event.agencies != [my_agency] %}<div>{{ event.agencies | agency_links }}</div>{% end %}
      </td>
      <td class="align-top">
        <div class="font-sans">
        {%@ Atoms::SourceBox sources: event.sources %}
        {% if icon_col %}<div class="inline text-base-content/75">{{ render EventLabel.new(event.type, :responsive) }}</div>{% end %}
        {{ event.linkified_text | raw }}
        {% if event.fuzz %} <span class="italic">(fuzz: {{ event.fuzz | md | strip_p }})</span>{% end %}
        {% questions_str = question_links(event)%}
        {% if questions_str %}{{ questions_str | raw }}{% end %}
        {% if event.type == 'interagency' && (event.people.any? || event.doge_aliases.any?) %}
          {%@ 'molecules/event_directory_display', event: event %}
        {% end %}
        {% if show_directories && event.type == 'directory' %}
          {%@ 'molecules/event_directory_display', event: event %}
        {% end %}
        {% if show_projects && event.projects.any? %}
          {%@ 'molecules/event_projects_display', event: event %}
        {% end %}
        </div>
      </td>
    </tr>
  {% end %}
  </tbody>
</table>
{% end %}
