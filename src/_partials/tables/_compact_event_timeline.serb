{%
require 'edtf'
import 'macros'

icon_col = true if icon_col.nil?
month_separator = true if month_separator.nil?
show_directories = true if show_directories.nil?
%}

 {% if events && events.any? %}
 {% prior_row_date = Date.edtf!(events[0].date)-1 %}

<table class="my-table-style mb-0 mt-0">
  <thead>
    <tr>
      <th class="my-2col-table-col1">Date</th>
      <th class="my-2col-table-col2">Event</th>
    </tr>
  </thead>
  <tbody>
  {% events.each do |event| %}
    {% parsed_date = Date.edtf(event.date) %}
    {% if month_separator && parsed_date.month > prior_row_date.month %}
    <tr>
      <td class="text-center font-bold italic bg-base-300" colspan="100%">{{ parsed_date.strftime("%B %Y") }}</td>
    </tr>
    {% end %}
    <tr class="font-sans" id="{{ event.id }}">
    {% prior_row_date = parsed_date %}
      <td class="align-top border-base-300">
        {{ render EdtfFormat.new(event.date, :compact) }} {{ event.agencies | agency_links }}
      </td>
      <td class="align-top">
        <div class="font-sans">
        {% if icon_col %}<div class="inline text-base-content/75"><i class="fa-sharp fa-solid {{ event_icon(event.type) }}"></i> <span class="hidden md:inline font-bold">{{ event_title(event.type) }}: </span></div>{% end %}
        {{ event.linkified_text | raw }}
        {% if event.fuzz %} <span class="italic">(fuzz: {{ event.fuzz | md | strip_p }})</span>{% end %}
        {% questions_str = question_links(event)%}
        {% if questions_str %}{{ questions_str | raw }}{% end %}
        {%@ 'atoms/alt_source_link', sources: event.sources %}
        {% if event.type == 'interagency' && (event.people.any? || event.doge_aliases.any?) %}
          {%@ 'molecules/event_directory_display', event: event %}
        {% end %}
        {% if show_directories && event.type == 'directory' %}
          {%@ 'molecules/event_directory_display', event: event %}
        {% end %}
        </div>
      </td>
    </tr>
  {% end %}
  </tbody>
</table>
{% end %}
