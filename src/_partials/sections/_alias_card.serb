{% import "macros" %}

<div class="mt-8 mb-8">
<div class="mb-5 mt-5">
  <div class="flex justify-between sm:justify-start items-end">
    <div class="flex-none order-last sm:order-first text-lg sm:text-xl md:text-2xl leading-none mb-0 sm:pr-2"><i class="fa-sharp fa-solid fa-user-secret"></i></div>
    <div class="flex-none order-first sm:order-1ast"><h2 id="{{ doge_alias.id }}" class="text-lg sm:text-xl md:text-2xl leading-none font-title">{{ doge_alias.id }}</h2></div>
  </div>
  
  {% if doge_alias.name %}
  <h3>{% if doge_alias.name_truth == 'verified' %}Verified:{% else %}Likely:{% end %} {%@ Atoms::PersonLink doge_alias.name %}</h3>
  {% end %}

  <div class="sm:ml-7 md:ml-8 lg:ml-9.5 lining-nums">
    {% if doge_alias.evidence %}
    <div>
    <div class="my-text">{{ doge_alias.linkified_evidence | raw }}</div>
    </div>
    {% end %}

    {% if doge_alias.positions && doge_alias.positions.any? %}
    <div>
    <h3 class="h3 mt-5 mb-0">Positions:</h4>
    {%@ 'tables/person_positions', positions: doge_alias.positions %}
    </div>
    {% end %}

    {% events = doge_alias.events %}
    {% if events.any? %}
    <div>
      <h3 class="h3 mt-5 mb-0">Events:</h3>
      {%@ Table::Events events %}
    </div>
    {% end %}

    {% roles = SystemRole.eager(:govt_system).where(doge_alias_id: doge_alias.id).all.compact %}
    {% if roles.any? %}
      <div class="mt-3">
        <h3 class="mb-0 mt-0 h3">Systems</h3>
        {%@ 'tables/person_systems', roles: roles %}
      </div>
    {% end %}
  </div>
</div>
