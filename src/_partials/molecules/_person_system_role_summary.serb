{% import 'macros' %}
<a href="/all/systems#{{ role.govt_system_id }}">{{ role.govt_system.name }}</a>
<span class="text-nowrap">{%@ Atoms::DateRange start_date: role.date_granted, end_date: role.date_revoked %}</span>
<br/>
<span class="italic">{%@ Atoms::Blurb role.govt_system.description %}</span>
<br/>
{%@ 'system_access_type', role: role %} access
{% if role.date_last_used %} (last access <span class="my-date">{%@ Atoms::DateLabel role.date_last_used %})</span>{% end %}
{% if role.never_accessed %} (never accessed){% end %}
{% if role.ao_type %} granted by {{ ao_type_display(role) }}{% end %}
{% if role.ao_doge && role.ao_name %} {%@ Atoms::PersonLink role.ao_name %}{% end %}
{% if role.table_note %} «<em>{%@ Atoms::Blurb role.table_note %}</em>» {% end %}
