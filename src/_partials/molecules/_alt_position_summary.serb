
{% import 'macros' %}

{% macro 'hire_details' do |pos|
    hire_details = [
      pos.sge ? "<abbr title=\"Special Government Employee\">SGE</abbr>" : nil,
      pos.nte_date ? "<abbr title=\"not to exceed\">NTE</abbr> <span class=\"my-date\">#{EdtfFormat.new(pos.nte_date, :compact_year)}</span>" : nil,
      pos.pay_grade,
      pos.excepted ? 'excepted' : nil ,
      pos.salary == "$0" ? "volunteer" : nil ,
      pos.salary && pos.salary != '$0' ? "<span class=\"font-semibold my-emphasis\">#{pos.salary}</span>" : nil,
      pos.reimbursement_amount ? "reimbursed <strong>#{pos.reimbursement_amount}</strong>" : nil
    ].compact

    if hire_details.any?
      hire_str = " (#{hire_details.join(', ')})"
    else
      nil
    end
  end

  macro 'type_str' do |pos, agency|
    case pos.type
    when 'other'
      nil
    when 'detailed'
      if pos.from_truth != 'reported' && pos.from_truth != 'verified'
        "likely detailed"
      else
        "detail"
      end
    when 'promotion'
      pos.title ? 'promoted to' : 'promoted'
    when 'demotion'
      pos.title ? 'demoted to' : 'demoted'
    when 'converted'
      'converted to permanent position'
    when 'internal'
      'internal xfer'
    when 'appointed'
      'appointed'
    when 'unknown'
      'unknown start type'
    else
      pos.type
    end
  end
%}

{% if position.doge_alias_id && position.name %}[as <a href="/people/aliases#{{ position.doge_alias_id }}" class="link-hover">{{ position.doge_alias_id }}</a>]{% end %}
{{ type_str(position, agency) | raw }}
{% if position.title %}<span class="my-emphasis">{{ position.title }}</span>{% end %}
{{ hire_details(position) | raw }}
{% if position.table_note %}«<span class="italic">{{ position.table_note | md | strip_p }}</span>»{% end %}
