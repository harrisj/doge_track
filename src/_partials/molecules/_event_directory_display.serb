{% unidentified_aliases = event.doge_aliases.select {|d| d.name.nil? } %}
{% if unidentified_aliases.any? %}
  <div>{{ render CategoryLabel.new('alias', :icon) }} {{ people.map(&:id) | alias_links }}</div>
{% end %}
{% if event.people.any? %}
  <div>{{ render CategoryLabel.new('person', :icon) }} {{ event.people.map(&:name) | people_links }}</div>
{% end %}
