{% agency_contacts = independent_agencies.map {|a| {id: a[:id], name: a[:name], first_contact: '', people: []} }
   events.each do |event|
    if event != 'official'
      event.agencies.each do |ea|
        contact = agency_contacts.find {|ac| ac[:id] == ea.id}
        next if contact.nil?
        contact[:first_contact] = event.date if contact[:first_contact].blank?
        event[:people].each do |person|
          next if contact[:people].include?(person)
          contact[:people].append(person)
        end
      end
    end
   end

   agency_contacts.reject!{|ac| ac[:first_contact].blank?}
   agency_contacts.sort_by!{|ac| ac[:first_contact]}
   agency_contacts.each {|ac| ac[:people].sort_by!{|p| p.sort_name}}
%}

<table class="table table-xs sm:table-sm zebra">
  <thead>
    <tr>
    <th class="align-left">Date</th>
    <th class="align-left">Agency</th>
    <th class="align-left">DOGE Team</th>
    </tr>
  </thead>
  <tbody>
    {% agency_contacts.each do |ac| %}
    <tr>
      <th class="align-left">{{ render EdtfFormat.new(ac[:first_contact], :compact) }}</th>
      <td class="align-left"><a href="#{{ ac[:id] }}">{{ ac[:name] }}</a></td>
      <td class="align-left">{{ ac[:people] | people_links }}</td>
    </tr>
    {% end %}
  </tbody>
</table>
