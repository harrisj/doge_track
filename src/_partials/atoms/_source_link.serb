{% if item.sources.any? %}<div class="text-nowrap inline-block float-right ml-2"><i class="fa-sharp fa-solid fa-receipt"></i> {% item.sources.each_with_index do |source, i| %}{% if i > 0 %}, {% end %}<a href="{{ source.url }}" class="link-hover"><span class="italic text-2xs sm:text-xs">{{ source.short_name }}</span></a>{% end %}</div>{% end %}
