{% show_dest ||= true %}
{% if position.agency_id %}
  {% raise position.inspect if position.agency.nil? %}

  <span class="md:text-nowrap">{% if position.from_agency_id %}
    {% arrow = position.type == 'internal' ? 'arrows-left-right' : 'arrow-right' %}
    {{ agency_link(position.from_agency_id, position.from_agency.short_name) }}{% if position.from_truth == 'guessed' %}?{% end %} <i class="fa-sharp fa-solid fa-{{ arrow }}"></i> {{ agency_link(position.agency_id, position.agency.short_name) }}
  {% elsif position.type == 'appointed' || position.type == 'consultant' %}
    <i class="fa-sharp fa-solid fa-person-to-door"></i>{% if show_dest %} {{ agency_link(position.agency_id, position.agency.short_name) }}{% end %}
  {% elsif position.type == 'promotion' %}
    <i class="fa-sharp fa-solid fa-arrow-up"></i>{% if show_dest %} {{ agency_link(position.agency_id, position.agency.short_name) }}{% end %}
  {% elsif position.type == 'demotion' %}
    <i class="fa-sharp fa-solid fa-arrow-down"></i>{% if show_dest %} {{ agency_link(position.agency_id, position.agency.short_name) }}{% end %}
  {% elsif position.type == 'converted' %}
    <i class="fa-sharp fa-solid fa-person-shelter"></i>{% if show_dest %} {{ agency_link(position.agency_id, position.agency.short_name) }}{% end %}
  {% else %}
    {% if show_dest %}{{ agency_link(position.agency_id, position.agency.short_name) }}{% end %}
  {% end %}</span>
{% end %}
