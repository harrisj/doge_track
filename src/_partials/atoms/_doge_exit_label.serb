{% import 'macros' %}
{% if position.end_date && position_end_type(position) %}<div>{% if position.person && !position.person.govt_exit_date.nil? && position.person.govt_exit_date == position.end_date %}<strong>Left DOGE{% if position.person.govt_exit_truth == 'guessed' %} (guessed){% end %}</strong>{% else %}{{ position_end_type(position) | raw }}{% end %}</div>{% end %}
