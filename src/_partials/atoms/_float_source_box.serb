{% if sources.any? %}
<div class="float-right pl-2 pb-2">
<div class="dropdown dropdown-left ml-1 text-sm">
  <div tabindex="0" role="button" class="strong"> <i class="fa-sharp fa-solid fa-receipt"></i></div>
  <div class="dropdown-content bg-base-100 rounded-box border-4 z-1 p-1 pl-5 shadow-sm text-sm divide-y-1">
    <div class="bg-base-200 -indent-2"><i class="fa-sharp fa-regular fa-receipt"></i> {% if sources.count > 1 %}Sources{% else %}Source{% end %}</div>
    <ul class="list-none w-xs sm:w-sm md:w-md lg:w-lg">
        {% sources.each do |source| %}
        <li class="text-xs -indent-2"><a target="_blank" href="{{ source.url }}">{{ source.title }}</a> <i class="fa-sharp fa-solid fa-up-right-from-square"></i> <span class="italic">{{ source.publisher.name }}{% if source.pub_date %}, {{ source.pub_date }}{% end %}</span></li>
        {% end %}
    </ul>
  </div>
</div>
</div>
{% end %}
