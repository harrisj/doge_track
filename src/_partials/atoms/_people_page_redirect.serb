{% import 'macros' %}

{% macro 'title_for_person' do |person|
   page = site.data.page_listing.sections.map {|s| s.pages }.flatten.find {|s| s.url.gsub(/\/?#.+$/, '') == person.page_url.gsub(/\/?#.+$/, '') }
   if page
    page.title
   else
    nil
   end
  end
%}

<div class="mb-10 mt-1">
  <div class="flex justify-between sm:justify-start items-end not-prose">
    <div class="flex-none order-last sm:order-first text-lg sm:text-xl md:text-2xl leading-none mb-0 sm:pr-2">{{ render CategoryLabel.new(person.category, :icon) }}</div>
    <div class="flex-none order-first sm:order-1ast"><h2 id="{{person.slug}}" class="mt-0 mb-0 text-lg sm:text-xl md:text-2xl leading-none font-title">{{ person.name }}</h2></div>
  </div>

  <div>Info moved to {{ person_link(person, display=title_for_person(person)) }}</div>
</div>
