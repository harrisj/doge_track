<h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl xl:text-7xl leading-none tracking-tight font-title">{{ agency.name }}</h1>
{% if agency.children.any? %}
<h2 class="text-xl sm:text-2xl md:text-3xl lg:text-4xl xl:text-5xl leading-none tracking-tight font-title">subagencies: {{ agency.children | map: ->(a) { a.short_name } | sort | join: ", " }}</h2>
{% end %}

<br/>