{% macro 'display_type' do |sys|
    case sys.type
    when 'ssp'
      'Shared Service Provider'
    when 'saas'
      'Software as a Service'
    else
      sys.type.capitalize
    end
  end
%}

<div class="mb-5">
<h3 class="prose prose-lg h3" id="{{ govt_system.id }}">{{ govt_system.acronym || govt_system.name }}</h3>

<table class="my-table-style">
<tbody>
  <tr>
  <th class="align-top w-1/4">Name</th>
  <td class="align-top w-3/4">{{ govt_system.name }}</td>
  </tr>

  {% if govt_system.agency_id %}
  <tr>
  <th class="align-top">Agency</th>
  <td class="align-top">{{ agency_link(govt_system.agency_id) }}</td>
  </tr>
  {% end %}

  <tr>
  <th class="align-top">Category</th>
  <td class="align-top">{{ govt_system.category }}</td>
  </tr>

  <tr>
  <th class="align-top">Type</th>
  <td class="align-top">{{ display_type(govt_system) }}</td>
  </tr>

  <tr>
  <th class="align-top">Description</th>
  <td class="align-top">{{ govt_system.description | md | strip_p }}</td>
  </tr>

  {% if govt_system.population %}
  <tr>
  <th class="align-top">Covers</th>
  <td class="align-top">{{ govt_system.population }}</td>
  </tr>
  {% end %}

  {% if govt_system.risk %}
  <tr>
  <th class="align-top">Privacy Risk</th>
  <td class="align-top">{{ govt_system.risk }}</td>
  </tr>
  {% end %}

  {% if govt_system.pia || govt_system.sorn %}
  <tr>
  <th class="align-top">Privacy Docs</th>
  <td class="align-top">
  {% if govt_system.pia %}<a href="{{ govt_system.pia }}">[Privacy Impact]</a>{% end %}
  {% if govt_system.sorn %}<a href="{{ govt_system.sorn }}">[System Records]</a>{% end %}
  </td>
  </tr>
  {% end %}

  <tr>
  <th class="align-top">Access</th>
  <td>
    {% sources = roles.map(&:sources).flatten.compact.uniq %}
    {%@ 'atoms/float_source_box', sources: sources %}
    <ul>
      {% roles.each do |role| %}
      <li>
      {% if govt_system.type == 'ssp' || govt_system.type == 'saas' %}
        {{ agency_link(role.agency_id) }}:
      {% end %}
      {% if role.name %}{{ person_link(role.name) }}{% elsif role.doge_alias_id %}{{ alias_link(role.doge_alias_id) }}{% end %}
      {%@ 'atoms/date_range_label', first: role.date_granted, last: role.date_revoked %}
      {% if role.type != 'read' %}
      ({%@ 'system_access_type', role: role %} access)
      {% end %}
      </li>
      {% end %}
    </ul>
  </td>
  </tr>
</tbody>
</table>
</div>
