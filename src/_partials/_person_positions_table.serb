{% import 'macros' %}
<table class="mt-4 not-prose table table-xs md:table-sm xl:table-md">
  <thead>
  <tr class="">
    <th class="text-left w-35">Move</th>
    <th class="text-left w-40">Timeframe</th>
    <th class="text-left">Position</th>
  </tr>
  </thead>
  <tbody>
    {% positions.each do |pos| %}
    <tr class="align-top font-mono">
      <td class=""><nobr>
          {% if pos.from_agency_id %}
            {{ agency_link(pos.from_agency_id) }}
            <i class="fa-solid fa-arrow-right"></i>
            {{ agency_link(pos.agency_id) }}
          {% elsif pos.type == 'appointed' %}
            Hired at {{ agency_link(pos.agency_id) }}
          {% elsif pos.type == 'promotion' %}
            Promoted at {{ agency_link(pos.agency_id) }}
          {% elsif pos.type == 'demotion' %}
            Demoted at {{ agency_link(pos.agency_id) }}
          {% else %}
            {{ agency_link(pos.agency_id) }}
          {% end %}</nobr>
      </td>
      <td class="align-top">{% if pos.start_date || pos.end_date %}{{ render EdtfFormat.new(pos.start_date, :compact, true) }} - {{ render EdtfFormat.new(pos.end_date, :compact) }}{% else %}<em>dates unknown</em>{% end %}</td>
      <td class="align-top">{% if pos.type == 'detailed' %}Detailed {% end %}{% if pos.type == 'internal' %}Internal xfer {% end %}{{ position_title(pos) }}{% if pos.pay_grade %} <strong>{{ pos.pay_grade }}</strong> {% end %}{% if pos.salary %} {{ pos.salary }}{% end %}{% if pos.table_note %} <em>{{ pos.table_note | markdownify | remove: '<p>' | remove: '</p>' }}</em>{% end %}</td>
    </tr>
    {% end %}
  </tbody>
</table>