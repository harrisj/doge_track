{% import 'macros' %}

<table class="mt-4 table-fixed table-xs table-auto sm:table-sm lg:table-md border-4">
  <thead>
  <tr class="my-text-2sm">
    <th class="text-left w-1/4 md:w-1/4 lg:w-1/5 xl:w-1/6">Position</th>
    <th class="text-left">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% positions.each do |pos| %}
    {% summary = position_summary(pos) %}
    <tr class="font-mono">
      <td class="align-top text-left w-1/3 md:w-1/4 lg:w-1/5 xl:w-1/6"><div class="sm:inline-block"><nobr>{{ position_move(pos) }}</nobr></div>
      <div class="sm:inline-block">{% if pos.start_date || pos.end_date %}<nobr>{{ render EdtfFormat.new(pos.start_date, :compact, :none) }} - {{ render EdtfFormat.new(pos.end_date, :compact) }}</nobr>{% end %}</div></td>
      <td class="align-top w-auto sm:w-2/3 md:w-3/4 lg:w-4/5 xl:w-5/6">{{ position_summary(pos) }}</td>
    </tr>
    {% end %}
  </tbody>
</table>