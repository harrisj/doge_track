{% import 'macros' %}

<table class="mt-4 table-fixed table-xs sm:table-sm lg:table-md border-4">
  <thead>
  <tr class="my-text-2sm">
    <th class="w-24 sm:w-26 md:w-32 text-left">Position</th>
    <th class="w-28 sm:w-30 md:w-34 lg:w-44 text-left">Times</th>
    <th class="text-left">Position</th>
  </tr>
  </thead>
  <tbody class="">
    {% positions.each do |pos| %}
    <tr class="font-mono">
      <td class="align-top text-left"><nobr>{{ position_move(pos) }}</nobr></td>
      <td class="align-top">{% if pos.start_date || pos.end_date %}{{ render EdtfFormat.new(pos.start_date, :compact, :none) }} - {{ render EdtfFormat.new(pos.end_date, :compact) }}{% else %}-{% end %}</td>
      <td class="align-top">{{ position_summary(pos) }}</td>
    </tr>
    {% end %}
  </tbody>
</table>