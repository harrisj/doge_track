{% import 'macros' %}

<table class="table table-auto table-xs sm:table-sm lg:table-md border-4">
  <thead>
  <tr class="">
    <th class="tab-cell-first text-xs">Position</th>
    <th class="text-left hidden md:table-cell text-xs">Dates</th>
    <th class="text-left text-xs">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% positions.each do |pos| %}
    {% summary = position_summary(pos) %}
    <tr class="font-mono">
      <td class="tab-cell-first align-top"><div class="sm:inline-block"><nobr>{{ position_move(pos) }}</nobr></div>
      <div class="md:hidden">{% if pos.start_date || pos.end_date %}{{ render EdtfFormat.new(pos.start_date, :compact, :none) }}-{{ render EdtfFormat.new(pos.end_date, :compact) }}{% end %}</div></td>
      <td class="align-top hidden md:table-cell">{% if pos.start_date || pos.end_date %}<span class="md:text-nowrap">{{ render EdtfFormat.new(pos.start_date, :compact, :none) }}-{{ render EdtfFormat.new(pos.end_date, :compact) }}</span>{% end %}</td>
      <td class="align-top ">{{ position_summary(pos) | md}}</td>
    </tr>
    {% end %}
  </tbody>
</table>