{% import 'macros' %}

<table class="table table-fixed sm:table-auto table-xs sm:table-sm lg:table-md border-4">
  <thead>
  <tr class="">
    <th class="w-3/12 sm:w-2/12 text-xs">Position</th>
    <th class="text-left hidden sm:table-cell text-xs sm:w-1/12">Dates</th>
    <th class="w-9/12 text-left text-xs max-w-auto sm:min-w-auto">Notes</th>
  </tr>
  </thead>
  <tbody class="">
    {% positions.each do |pos| %}
    {% summary = position_summary(pos) %}
    <tr class="font-sans" id="{{ pos.id }}">
      <td class="align-top"><div class="sm:inline-block sm:text-nowrap">{{ position_move(pos) }}</div>
        <div class="sm:hidden">
          {% if pos.start_date || pos.end_date %}<div class="md:text-nowrap">{{ render EdtfFormat.new(pos.start_date, :compact, :none) }}-{{ render EdtfFormat.new(pos.end_date, :compact) }}{% end %}
          {% if pos.end_date && position_end_type(pos) %}<div>{% if pos.person && !pos.person.govt_exit_date.nil? %}<strong>Left DOGE</strong>{% else %}{{ position_end_type(pos) | raw }}{% end %}</div>{% end %}
        </div>    
      </td>
      <td class="align-top hidden sm:table-cell">
        {% if pos.start_date || pos.end_date %}<div class="md:text-nowrap">{{ render EdtfFormat.new(pos.start_date, :compact, :none) }}-{{ render EdtfFormat.new(pos.end_date, :compact) }}</div>{% end %}
        {% if pos.end_date && position_end_type(pos) %}<div>{% if pos.person && !pos.person.govt_exit_date.nil? %}<strong>Left DOGE</strong>{% else %}{{ position_end_type(pos) | raw }}{% end %}</div>{% end %}
      </td>
      <td class="align-top">{{ position_summary(pos) | md | strip_p }}</td>
    </tr>
    {% end %}
  </tbody>
</table>