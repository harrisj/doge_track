<div class="tabs tabs-lift">
  {% tabs.each_with_index do |key_value, i| %}
  <input type="radio" name="generic_tabs" class="tab" aria-label="{{ key_value[0] }}" {% if i == 0 %}checked="checked"{% end %} />
  <div class="tab-content bg-base-100 border-base-300 p-6"><div class="prose prose-stone max-w-none prose-li:m-[0.1em] dark:prose-invert">{{ key_value[1] | markdownify }}</div></div>
  {% end %}
</div>