
{% macro "person_url" do |name| 
    person = site.data.people.find {|p| p.name.downcase == name || p.slug == name || p.sort_name.downcase == name.downcase }
    person ? person.path : nil
  end
%}

{% macro "person_link" do |p_id, display=nil|
    if p_id.nil?
      raise "Null passed to person_link"
    else 
      if p_id.is_a?(String)
        person = site.data.people.find {|p| p.name.downcase == p_id.downcase || p.slug == p_id || p.sort_name.downcase == p_id.downcase }
      elsif p_id.obj_type && p_id.obj_type == 'Person'
        person = p_id
      else
        raise "Unknown object passed to person_link #{p_id.inspect}"
      end

      if person && person.path && person.path != 'none'
        display ||= person.name
        "<a href=\"#{person.path}\">#{display}</a>".html_safe
      else
        display || p_id
      end
    end
  end
%}

{% macro "find_agency" do |a_id|
    if a_id.is_a?(String)
      site.data.agencies.find {|a| a.id == a_id || a.slug == a_id }
    elsif a_id.obj_type == 'Agency'
      a_id
    elsif a_id.agency_id
      site.data.agencies.find {|a| a.id == a_id.agency_id || a.slug == a_id.agency_id }
    else
      a_id
    end
   end
%}

{% macro "agency_url" do |id| 
    agency = site.data.agencies.find {|a| a.id == id || a.slug == id }
    agency ? agency.path : nil
  end
%}

{% macro "agency_link" do |a_id, display=nil|
    if a_id.nil?
      ""
    else
      agency = find_agency(a_id)

      if agency && agency.path
        display ||= agency.short_name
        "<a href=\"#{agency.path}\">#{display}</a>".html_safe
      else
        raise(a_id.inspect)
        display || a_id
      end
    end
  end
%}

{% macro "agencies" do |arr|
    if arr.nil?
      []
    else
      out = arr.map { |item| find_agency(item) }.compact
    end
  end
%}

{% macro "agency_links" do |agency_list|
    agencies(agency_list).map {|a| agency_link(a)}.compact.join(", ").html_safe
  end
%}

{% macro "event_icon" do |event|
    case event.type
    when 'access'
      'fa-database'
    when 'action'
      'fa-wrench'
    when 'directory'
      'fa-users'
    when 'disruption'
      'fa-explosion'
    when 'interagency'
      'fa-handshake'
    when 'legal'
      'fa-legal'
    when 'milestone'
      'fa-map-pin'
    when 'official'
      'fa-landmark'
    when 'onboard'
      'fa-user-plus'
    when 'oversight'
      'fa-magnifying-glass'
    when 'offboard'
      'fa-user-minus'
    when 'sighting'
      'fa-binoculars'
    else
      'fa-note-sticky'
    end
  end
%}

{% macro "event_title" do |event|
    case event.type
    when 'access'
      'System Access'
    when 'action'
      'Action'
    when 'directory'
      'Directory'
    when 'disruption'
      'Disruption'
    when 'interagency'
      'Interagency Coordination'
    when 'legal'
      'Legal'
    when 'milestone'
      'Milestone'
    when 'official'
      'Official'
    when 'onboard'
      'Onboard'
    when 'oversight'
      'Oversight'
    when 'offboard'
      'Offboard'
    when 'sighting'
      'Sighting'
    else
      'Report'
    end
  end
%}