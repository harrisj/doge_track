
{% macro "person_url" do |name| 
    person = site.data.people.find {|p| p.name.downcase == name || p.slug == name || p.sort_name.downcase == name.downcase }
    person ? person.path : nil
  end
%}

{% macro "person_link" do |p_id, display=nil|
    if p_id.nil?
      raise "Null passed to person_link"
    else 
      if p_id.is_a?(String)
        person = site.data.people.find {|p| p.name.downcase == p_id.downcase || p.slug == p_id || p.sort_name.downcase == p_id.downcase }
      elsif p_id.obj_type && p_id.obj_type == 'Person'
        person = p_id
      else
        raise "Unknown object passed to person_link #{p_id.inspect}"
      end

      if person && person.path && person.path != 'none'
        display ||= person.name
        "<a class=\"link-hover\" href=\"#{person.path}\">#{display}</a>".html_safe
      else
        display || p_id
      end
    end
  end
%}

{% macro "find_agency" do |a_id|
    if a_id.is_a?(String)
      site.data.agencies.find {|a| a.id == a_id || a.slug == a_id }
    elsif a_id.obj_type == 'Agency'
      a_id
    elsif a_id.agency_id
      site.data.agencies.find {|a| a.id == a_id.agency_id || a.slug == a_id.agency_id }
    else
      a_id
    end
   end
%}

{% macro "agency_url" do |id| 
    agency = site.data.agencies.find {|a| a.id == id || a.slug == id }
    agency ? agency.path : nil
  end
%}

{% macro "agency_link" do |a_id, display=nil|
    if a_id.nil?
      ""
    else
      agency = find_agency(a_id)

      if agency && agency.path
        display ||= agency.short_name
        "<a class=\"link-hover\" href=\"#{agency.path}\">#{display}</a>".html_safe
      else
        raise(a_id.inspect)
        display || a_id
      end
    end
  end
%}

{% macro "load_agency" do |item|
    if item && item.agency_id
      item.agency = find_agency(item.agency_id)
    else
      item
    end
  end
%}

{% macro "agencies" do |arr|
    if arr.nil?
      []
    else
      out = arr.map { |item| find_agency(item) }.compact
    end
  end
%}

{% macro "agency_links" do |agency_list|
    agencies(agency_list).map {|a| agency_link(a)}.compact.join(", ").html_safe
  end
%}

{% macro "event_icon" do |event|
    case event.type
    when 'access'
      'fa-database'
    when 'action'
      'fa-wrench'
    when 'directory'
      'fa-users'
    when 'disruption'
      'fa-explosion'
    when 'interagency'
      'fa-handshake'
    when 'legal'
      'fa-legal'
    when 'milestone'
      'fa-map-pin'
    when 'official'
      'fa-landmark'
    when 'onboard'
      'fa-user-plus'
    when 'oversight'
      'fa-magnifying-glass'
    when 'offboard'
      'fa-user-minus'
    when 'sighting'
      'fa-binoculars'
    else
      'fa-note-sticky'
    end
  end
%}

{% macro "event_title" do |event|
    case event.type
    when 'access'
      'System Access'
    when 'action'
      'Action'
    when 'directory'
      'Directory'
    when 'disruption'
      'Disruption'
    when 'interagency'
      'Interagency Coordination'
    when 'legal'
      'Legal'
    when 'milestone'
      'Milestone'
    when 'official'
      'Official'
    when 'onboard'
      'Onboard'
    when 'oversight'
      'Oversight'
    when 'offboard'
      'Offboard'
    when 'sighting'
      'Sighting'
    else
      'Report'
    end
  end
%}

{% macro "person_background" do |person|
    if person.background.nil?
      ""
    elsif person.background == "hr"
      "HR"
    else
      person.background.titleize
    end
   end
%}

{% macro "position_title" do |position|
    if position.title
      position.title
    elsif position.type == 'consultant'
      'Consultant'
    else
      ''
    end
   end %}

{% macro "position_move" do |pos| 
  if pos.agency_id
    raise pos.inspect unless pos.agency
    
    out = if pos.from_agency_id
      arrow = pos.type == 'internal' ? 'arrows-left-right' : 'arrow-right'
      "#{agency_link(pos.from_agency_id, pos.from_agency.short_name)}#{'?' if pos.from_truth == 'guessed'} <i class=\"fa-solid fa-#{arrow}\"></i> #{agency_link(pos.agency_id, pos.agency.short_name)}"
    elsif pos.type == 'appointed'
      "<i class=\"fa-solid fa-right-to-bracket\"></i> #{agency_link(pos.agency_id, pos.agency.short_name)}"
    elsif pos.type == 'promotion'
      "<i class=\"fa-solid fa-up-long\"></i> #{agency_link(pos.agency_id, pos.agency.short_name)}"
    elsif pos.type == 'demotion'
      "<i class=\"fa-solid fa-down-long\"></i> #{agency_link(pos.agency_id, pos.agency.short_name)}"
    else
      agency_link(pos.agency_id, pos.agency.short_name)
    end
    
    out.html_safe
  else
    ''
  end
end %}

{% macro 'position_summary' do |pos|
    type_str = case pos.type
      when 'other'
        nil
      when 'internal'
        'internal xfer'
      else
        pos.type
      end

    title_str = ""
    if pos.title
      title_str += " <strong>#{pos.title}</strong>"

      if pos.office
        title_str += " (#{pos.office})"
      end
    end

    hire_details = [
      pos.sge ? "<abbr title=\"Special Government Employee\">SGE</abbr>" : nil,
      pos.appt_type && pos.appt_type != 'Other' ? pos.appt_type : nil,
      pos.nte_date ? "<abbr title=\"not to exceed\">NTE</abbr> #{pos.nte_date}" : nil,
      pos.pay_grade,
      pos.supervisory ? 'supervisory' : nil,
      pos.excepted ? 'excepted' : nil ,
      pos.salary == "$0" ? "volunteer" : nil ,
      pos.salary && pos.salary != '$0' ? "<strong>#{pos.salary} annually</strong>" : nil,
      pos.reimbursement_amount ? "reimbursed <strong>#{pos.reimbursement_amount}</strong>" : nil
    ].compact

    if hire_details.any?
      hire_str = " (#{hire_details.join(', ')})"
    end

    if pos.table_note
      note_str = "[#{pos.table_note}]"
    end

    out_str = [type_str, title_str, hire_str, note_str].map {|x| x.blank? ? nil : x }.compact.map {|x| "<span>#{x}</span>"}.join(" ")

    out_str.html_safe
   end
%}
