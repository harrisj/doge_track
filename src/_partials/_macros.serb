
{% macro "md" do |text|
    text = markdownify(text).gsub('<a href=', '<a class="link-hover" href=')
    text.html_safe
  end
%}

{% macro "strip_p" do |text|
    text.gsub(/<\/?p>/, '').html_safe
  end
%}

{% macro "lookup_person" do |name|
    Person[name]
end %}

{% macro 'lookup_agency' do |agency_id|
    Agency[agency_id]
end %}

{% macro 'lookup_alias' do |alias_id|
    DogeAlias[alias_id]
  end %}

{% macro 'lookup_event' do |event_id|
    Event[event_id]
  end %}

{% macro 'lookup_position' do |pos_id|
    Position[pos_id]
  end %}

{% macro "find_person" do |p_id|
    if p_id.is_a?(String)
      site.data.people.find {|p| p.name.downcase == p_id || p.slug == p_id || p.sort_name.downcase == p_id.downcase }
    elsif p_id.is_a? Person
      p_id
    elsif p_id.name
      site.data.people.find {|p| p.name == p_id.name }
    else
      a_id
    end
   end
%}

{% macro "person_link" do |p_id, display=nil|
    if p_id.nil?
      raise "Null passed to person_link"
    else 
      if p_id.is_a?(String)
        person = Person.where(Sequel.|({name: p_id}, {slug: p_id}, {sort_name: p_id})).first
      elsif p_id.is_a? Person
        person = p_id
      else
        raise "Unknown object passed to person_link #{p_id.inspect}"
      end

      if person
        display ||= person.name
        "<a class=\"link-hover\" href=\"#{person.page_url}\">#{display}</a>".html_safe
      else
        display || p_id
      end
    end
  end
%}

{% macro "alias_link" do |alias_id|
  "<a class=\"link-hover\" href=\"/people/aliases##{alias_id}\">#{alias_id}</a>".html_safe
  end
%}

{% macro "alias_links" do |arr| 
    arr.compact.map {|a| alias_link(a)}.join(", ").html_safe
   end
%}

{% macro "people" do |arr|
    if arr.nil?
      []
    else
      out = arr.map { |item| find_person(item) }.compact
    end
  end
%}

{% macro "find_agency" do |a_id|
    if a_id.is_a?(String)
      Agency.filter(Sequel.|({id: a_id}, {slug: a_id})).first
    elsif a_id.is_a? Agency
      a_id
    elsif a_id.agency_id
      Agency.where(id: a_id.agency_id).first
    else
      a_id
    end
   end
%}

{% macro "agency_link" do |a_id, display=nil|
    if a_id.nil?
      ""
    elsif a_id.is_a?(String)
      agency = find_agency(a_id)
      agency_link(agency)
    else
      if a_id.short_name
        display ||= a_id.short_name
      else
        display ||= a_id
      end

      "<a class=\"link-hover\" href=\"#{a_id.page_url}\">#{display}</a>".html_safe
    end
  end
%}

{% macro "agencies" do |arr|
    if arr.nil?
      []
    else
      out = arr.map { |item| find_agency(item) }.compact
    end
  end
%}

{% macro "agency_links" do |agency_list|
    agencies(agency_list).map {|a| agency_link(a)}.compact.join(", ").html_safe
  end
%}

{% macro "people_links" do |people_list|
    people_list.map {|p| person_link(p)}.compact.join(", ").html_safe
  end
%}

{% macro "event_icon" do |event_type|
    case event_type
    when 'access'
      'fa-database'
    when 'action'
      'fa-hammer-crash'
    when 'directory'
      'fa-people-group'
    when 'disruption'
      'fa-explosion'
    when 'interagency'
      'fa-diagram-venn'
    when 'legal'
      'fa-legal'
    when 'milestone'
      'fa-map-pin'
    when 'official'
      'fa-landmark'
    when 'onboard'
      'fa-person-to-door'
    when 'oversight'
      'fa-microscope'
    when 'offboard'
      'fa-left-from-bracket'
    when 'sighting'
      'fa-users-viewfinder'
    else
      'fa-newspaper'
    end
  end
%}

{% macro "event_title" do |event_type|
    case event_type
    when 'access'
      'Access'
    when 'action'
      'Action'
    when 'directory'
      'Directory'
    when 'disruption'
      'Disruption'
    when 'interagency'
      'Interagency'
    when 'legal'
      'Legal'
    when 'milestone'
      'Milestone'
    when 'official'
      'Official'
    when 'onboard'
      'Onboard'
    when 'oversight'
      'Oversight'
    when 'offboard'
      'Offboard'
    when 'sighting'
      'Sighting'
    else
      'Report'
    end
  end
%}

{% macro 'person_icon' do |person| 
    case person.category
    when 'booster'
      'fa-megaphone'
    when 'leadership'
      'fa-briefcase'
    when 'enabler'
      'fa-door-open'
    when 'support'
      'fa-chair-office'
    when 'wrecker'
      'fa-bomb'
    else
      'fa-circle-question'
    end
  end
%}

{% macro 'person_skill' do |person| 
    if person.skill.nil?
      ''
    else
      person.skill.titleize
    end
  end
%}

{% macro "position_title" do |position|
    if position.title
      position.title
    elsif position.type == 'consultant'
      'Consultant'
    else
      ''
    end
   end %}

{% macro "document_type" do |doc| 
    if doc.type == 'mou'
      'MOU'
    elsif doc.type == 'onboard'
      'onboarding'
    else
      doc.type
    end
  end
%}

{% macro "question_links" do |obj| 
    if obj.questions && obj.questions.any?
      questions = obj.questions.map {|q| "<a class=\"link-hover tooltip\" href=\"/questions##{q.id}\" data-tip=\"Open Question: #{q.question}\"><i class=\"fa-sharp fa-solid fa-circle-question\"></i></a>"}
      questions_str = questions.join(" ")
    else
      nil
    end
   end
%}

{% macro 'position_end_type' do |pos| 
    case pos.end_type
    when 'detail_ended'
      'detail end'
    when 'replaced'
      if pos.replaced_by
        "<a class=\"link-hover sm:text-nowrap\" href=\"##{pos.replaced_by}\"><i class=\"fa-sharp fa-solid fa-up-right-from-square\"></i> next role</a>"
      else
        'replaced'
      end
    when 'fired'
      '<i class="fa-sharp fa-regular fa-triangle-exclamation"></i> <strong>fired</strong>'
    when 'unknown'
      nil
    when nil
      nil
    else
      pos.end_type
   end
  end
%}

{% macro 'system_access_type' do |role| 
    case role.type
    when 'admin'
      '**admin**'
    when 'read_write'
      '**read/write**'
    when 'source-code'
      'source code'
    else
      role.type
    end    
  end
%}

{% macro 'ao_type_display' do |role| 
    case role.ao_type
      when 'director'
        'Agency Director'
      when 'deputy'
        'Deputy Director'
      when 'cio'
        'CIO'
      when 'cto'
        'CTO'
      when 'isso'
        'ISSO'
      else
        'Other'
      end
   end
%}

# Don't use this a lot, it's slow! Better to pre-linkify in the database
{% macro 'linkify_text' do |text|
   if text.blank?
      ''
   else
     out = text.dup

      Person.each do |person|
        out.gsub!(/\b#{person.name}\b/, person_link(person))
      end

      Agency.each do |agency|
        out.gsub!(/\b#{agency.id}\b/, agency_link(agency)) if agency.id =~ /^[A-Z]+$/
        out.gsub!(/\b#{agency.name}\b/, agency_link(agency, agency.name))
      end
    end
  out
end %}
