{% import 'macros' %}

<h2 id="{{person.slug}}" class="prose sm:prose-lg md:prose-xl lg:prose-2xl prose-stone max-w-none prose-li:m-[0.1em] dark:prose-invert mb-0 mt-1 leading-none"><i class="fas {{ person_icon(person) }} mr-1 sm:mr-2"></i><span class="font-title">{{ person.name }}</span></h2>
<div class="sm:ml-7 md:ml-8 lg:ml-9.5 lining-nums">
  <div class="prose prose-sm md:prose-base prose-stone max-w-none prose-li:m-[0.1em] dark:prose-invert mb-2 leading-none"><strong>{{ person.category.titleize }}</strong>{% if person.age %}, age {{ person.age }}{% end %}</div>
  {% if person.blurb %}<p class="prose prose-sm md:prose-base prose-stone max-w-none prose-li:m-[0.1em] dark:prose-invert mb-0 leading-5 mb-2">{{ person.blurb | markdownify | remove: "<p>" | remove: "</p>" | raw }}</p>{% end %}
</div>

  <div class="sm:ml-3 md:ml-4 lg:ml-5 ">
{% if person.positions.any? %}
    {%@ 'person_positions_table', positions: person.positions %}
{% else %}
&nbpsp;
{% end %}
</div>


