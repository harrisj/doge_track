{% import 'macros' %}
<div class="mb-5 mt-1">
<h2 id="{{person.slug}}" class="text-lg sm:text-xl md:text-2xl leading-none mb-0"><i class="fas {{ person_icon(person) }} mr-1 sm:mr-2"></i><span class="font-title">{{ person.name }}</span></h2>
<div class="sm:ml-7 md:ml-8 lg:ml-9.5 lining-nums">
  <div class="prose prose-sm md:prose-base prose-stone max-w-none prose-li:m-[0.1em] dark:prose-invert mb-2 leading-none"><strong>{{ person.category.titleize }}</strong>{% if person.age %}, age {{ person.age }}{% end %}</div>
  {% if person.blurb %}<p class="prose prose-sm md:prose-base prose-stone max-w-none prose-li:m-[0.1em] dark:prose-invert mb-0 mt-0.5 leading-5 mb-2">{{ person.blurb | markdownify | remove: "<p>" | remove: "</p>" | raw }}</p>{% end %}
</div>

{% if person.positions.any? %}
<div class="sm:ml-3 md:ml-4 lg:ml-5 ">
    {%@ 'person_positions_table', positions: person.positions %}
</div>
{% end %}

{% if person.events.any? %}
<h3 class="sm:ml-7 md:ml-8 lg:ml-9.5 mb-0 mt-0 text-lg md:text-xl">Events</h3>
<div class="sm:ml-3 md:ml-4 lg:ml-5 ">
    {%@ 'compact_event_timeline', agency_col: true, events: person.events, month_separator: false, show_directories: false, always_show_date: true %}
</div>
{% end %}
</div>