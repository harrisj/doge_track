{% num_cols = 2 
agency_col = false if agency_col.nil?
icon_col = false if icon_col.nil?
month_separator = true if month_separator.nil?
always_show_date = false if always_show_date.nil?
show_directories = true if show_directories.nil?
num_cols +=1 if agency_col
num_cols +=1 if icon_col %}
 
 {% if events.any? %}
 {% prior_row_date = Date.edtf!(events[0].date)-1 %}

<table class="table table-auto table-xs sm:table-sm lg:table-md border-4 mb-0 mt-0">
  <thead>
    <tr>
      <th class="tab-cell-first text-xs">Date</th>
      {% if icon_col %}<th class="text-xs">Type</th>{% end %}
      {% if agency_col %}<th class="hidden sm:table-cell text-xs">Agency</th>{% end %}
      <th class="text-xs">Event</th>
    </tr>
  </thead>
  <tbody>
  {% events.each do |event| %}
    {% parsed_date = Date.edtf(event.date) %}
    {% if month_separator && parsed_date.month > prior_row_date.month %}
    <tr>
      <td class="bg-base-200" colspan="{{ num_cols - 1 }}" /><td class="bg-base-200 font-bold">{{ parsed_date.strftime("%B %Y") }}</td>
    </tr>
    {% end %}
    <tr class="font-mono" id="{{ event.id }}">
      <td class="align-top tab-cell-first">
       {% if always_show_date || parsed_date.edtf != prior_row_date.edtf %}
        <div class="inline-block">{{ render EdtfFormat.new(event.date, :compact) }}</div>
      {% end %}  
      {% prior_row_date = parsed_date %}
      {% if agency_col %}
      <div class="inline-block sm:hidden">{{ event.agencies | agency_links }}</div>
      {% end %}
      </td>
      {% if icon_col %}<td class="align-top w-min-content"><i class="fa {{ event_icon(event) }}"></i></td>{% end %}
      {% if agency_col %}<td class="align-top hidden sm:table-cell">{{ event.agencies | agency_links }}</td>{% end %}
      <td class="align-top overflow-auto">
        <div class="font-mono">
        {% if event.type == 'interagency' %}<strong>interagency: </strong>{% end %}
        {{ event.linkified_text | raw }}
        {% if event.fuzz %}&nbsp;[{{ event.fuzz | md }}]{% end %}
        {% if event.source && event.source_name %} <span class="text-nowrap">(<a href="{{ event.source }}" class="link-hover"><i class="fa-regular fa-newspaper"></i>&nbsp;<span class="italic text-2xs sm:text-xs">{{ event.source_name }}</span></a>)</span>{% end %}
        {% questions_str = question_links(event)%}
        {% if questions_str %}{{ questions_str | raw }}{% end %}
        </div>
        {% if event.type == 'interagency' %}
          <div>
              <div><i class="fas fa-landmark"></i> {{ event.agency_ids | agency_links }}</div>
              {% event.names_aliases.group_by(&:category).sort_by {|c, p| p.size}.reverse.each do |category, people| %}
                <div><i class="fas {{ person_icon(people.first) }}"></i> {{ people.map(&:name) | people_links }}</div>
              {% end %}
          </div>
        {% end %}
        {% if show_directories && event.type == 'directory' %}
          <div>
            {% event.names_aliases.group_by(&:category).sort_by {|c, p| p.size}.reverse.each do |category, people| %}
              <div><i class="fas {{ person_icon(people.first) }}"></i> {{ people.map(&:name) | people_links }}</div>
            {% end %}
          </div>
        {% end %}
      </td>
    </tr>
  {% end %}
  </tbody>
</table>
{% end %}