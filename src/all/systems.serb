---
title: All the Systems
description: All the government systems that DOGE has accessed or has been linked to
layout: page
---
{%@ Atoms::Title title: 'All Systems' %}

<section class="mb-10">
<h2 class="h2" id="obligations">Contracting and Grants</h2>

{% systems = GovtSystem.eager_graph(:system_roles).where(category: 'obligations').all %}
{% systems.each do |govt_system| %}
  {% roles = govt_system.system_roles %}
  {% next unless roles.any? %}
  {%@ 'systems_page_system', govt_system: govt_system, roles: roles %}
{% end %}
</section>

