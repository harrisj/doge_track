---
layout: default
---
{% urls = site.data.page_listing.sections.map {|s| s.pages }.flatten %}

{% page_index = urls.find_index {|x| x.url == resource.relative_url }
  if page_index
    prev_pg = urls[page_index-1]
    next_pg = urls[page_index+1]
  else
    prev_pg = nil
    next_pg = nil
  end
%}

<div class="lg:container lg:mx-auto px-8">
  {%@ 'header_bar', metadata: site.metadata, prev_pg: prev_pg, next_pg: next_pg %}
  <main class="my-text flex flex-col min-h-screen">
    {{ content }}
  </main>

  {% if page_index %}
    {%@ 'bottom_nav', prev_pg: prev_pg, next_pg: next_pg %}
  {% end %}

  {%@ 'footer', metadata: site.metadata %}
</div>
