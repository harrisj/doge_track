---
layout: default
---
{% urls = site.data.page_listing.sections.map {|s| s.pages }.flatten %}

{% page_index = urls.find_index {|x| x.url.gsub(/\/$/, '') == resource.relative_url.gsub(/\/$/, '') }
  if page_index
    prev_pg = urls[page_index-1]
    next_pg = urls[page_index+1]
  else
    prev_pg = nil
    next_pg = nil
  end
%}

<div class="drawer">
  <input id="my-drawer-3" type="checkbox" class="drawer-toggle" />
  <div class="drawer-content flex flex-col">
    <!-- Navbar -->
    {%@ 'sections/navbar' %}

    <!-- Page content here -->
    <div class="md:container md:max-w-5xl md:mx-auto px-0 sm:px-2">
      {% if site.metadata.vacation%}
        <div role="alert" class="alert alert-success">
          <i class="fa-sharp fa-solid fa-island-tropical"></i>
          <span><strong>On Vacation</strong> I'll update the data when I get back.</span>
        </div>
      {% end %}

      <main class="min-h-screen mt-4 px-3">
        {{ content }}
      </main>

    {% if page_index %}
      {%@ 'sections/bottom_nav', prev_pg: prev_pg, next_pg: next_pg %}
    {% end %}
  </div>

      {%@ 'sections/footer', metadata: site.metadata %}
      
  </div>
  <div class="drawer-side z-100">
    <label for="my-drawer-3" aria-label="close sidebar" class="drawer-overlay"></label>
    {%@ 'sections/menu' %}
  </div>
</div>