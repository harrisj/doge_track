---
layout: homepage
---
<div class="hero bg-base-200 pt-10">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold mb-0">DOGE Track</h1>
      <h4 class="text-2xl mt-1">Tracking The Damage</h4>
    </div>
  </div>
</div>

<div role="alert" class="alert alert-warning alert">
  <i class="fa-sharp fa-solid fa-person-digging"></i>
  <span><strong>Site is in beta.</strong> There is missing content and broken links. Layouts might change. Data might have bugs. Bear with me!</span>
</div>

<div class="mx-auto mt-10 prose">
{% site.data.page_listing.sections.each do |section| %}
<section class="prose mb-10">
<h2 class="title mb-1">{{ section.name }}</h2>

<ul>
  {% section.pages.each do |page| %}
  <li class="mt-0 mb-0"><a class="link-hover" href="{{ page.url }}">{{ page.title }}</a></li>
  {% end %}
</ul>
</section>
{% end %}
</div>
