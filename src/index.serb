---
layout: homepage
---
<div class="hero bg-base-200 pt-10">
  <div class="hero-content text-center">
    <div class="max-w-md">
      <h1 class="text-5xl font-bold mb-0">DOGE Track</h1>
      <h4 class="text-2xl mt-1">Tracking The Damage</h4>
    </div>
  </div>
</div>

<ul class="timeline timeline-vertical">
  {% timeline_start = true %}

  {% site.data.page_listing.sections.each do |section| %}
  <li>
    <hr/>
    <div class="{% if timeline_start %}timeline-start{% else %}timeline-end{% end %}">
      <ul class="menu menu-lg my-text-small-fixed">
      <li class="menu-title font-2xl font-bold">{{ section.name }}</li>
      {% section.pages.each do |page| %}
      <li><a href="{{ page.url }}">{{ page.title }}</a></li>
      {% end %}
      {% timeline_start = !timeline_start %}
      </ul>
    </div>
    <hr/>
  </li>
 {% end %}
</ul>