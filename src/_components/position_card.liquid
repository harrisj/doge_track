<div class="card is-one-quarter">
  <header class="card-header">
    <p class="card-header-title">{{ position.name }}</p>
  </header>
  <div class="card-content">
    <div class="content">
      <table class="table">
        <tr>
          <th>Agency</th>
          <td>{{ position.agency.short_name }}</td>
        </tr>
        <tr>
          <th>Duration</th>
          <td>{{ position.duration_summary }}</td>
        </tr>
      </table>
    </div>
  </div>
</div>