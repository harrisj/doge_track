<article class="media mb-1">
  <div class="media-left mr-2">
    <span class="icon is-small">
        <i class="fa {% render "event_type_icon", type: event.type %}"></i>
    </span>
  </div>
  <div class="media-content">
    <div class="content mb-0">
      <div class="level mb-0 is-mobile">
        <div class="level-left is-flex-direction-row is-align-content-flex-start">
          <div class="level-item"><strong>{% render "event_type_title", type: event.type %}</strong></div>
          <div class="level-item"><small>{{ event.date }}</small></div>
        </div>
    </div>
      <p class="is-size-5">{{ event.text }}</p>
    </div>
    <nav class="mb-0 is-mobile is-size-6">
      <div class="level-left is-flex is-gap-1 is-flex-direction-row is-align-content-flex-start is-flex-wrap-wrap">
        <div class="level-item"><span class="icon is-small"><i class="fas fa-building"></i></span>{{ event.agencies | map: "short_name" | join: ", " }}</div>
        {% if event.people != blank %} 
            {% for person in event.people %}
              <div class="level-item"><span class="icon is-small"><i class="fas fa-user"></i></span><a href="/people/{{ person.slug }}">{{ person.name }}</a></small></div>
            {% endfor %}
        {% endif %}
        {% if event.source_name != blank %} 
          <div class="level-item">
            <span class="icon is-small"><i class="fas fa-newspaper"></i></span>
            <a href="{{ event.source }}">{{ event.source_name }}</a>
          </div>
        {% endif %}
      </div>
    </nav>
  </div>
</article>