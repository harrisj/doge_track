<article class="media mb-1">
  <div class="media-left mr-2">
    <span class="icon is-small">
      <i class="fa {% render "event_type_icon", type: event.type %}"></i>
    </span>
  </div>
  <div class="media-content">
    <div class="content mb-0">
      <div class="is-flex is-mobile is-gap-0 is-size-6 is-align-content-flex-start is-align-items-center is-flex-wrap-wrap">
        <div class="has-text-weight-bold is-size-5">{% render 'event_type_title', type: event.type %}</div>
        <div class="ml-2 is-size-5">{{ event.date }}</div>
        <div class="icon-text is-align-items-center ml-2">
          <span class="icon is-small"><i class="fas fa-building"></i></span>
          {{ event.agencies | map: 'short_name' | join: ', ' }}
        </div>
        {% if event.source_name != blank %}
          <div class="icon-text is-align-items-center ml-1">
            <span class="icon is-small"><i class="fas fa-newspaper"></i></span>
            <a href="{{ event.source }}">{{ event.source_name }}</a>
          </div>
        {% endif %}
        {% if event.people != blank %}
          {% for person in event.people %}
            <div class="icon-text is-align-items-center ml-1">
              <span class="icon is-small"><i class="fas fa-user"></i></span>
              {%- render 'link_person', name: person.name, pages: pages %}
            </div>
          {% endfor %}
        {% endif %}
      </div>
      <p class="is-size-5">{{ event.text }}</p>
    </div>
  </div>
</article>
