<table class="table is-size-5">
  <thead>
    <tr>
      <th>Name</th>
      <th>Age</th>
      <th>Start Date</th>
      <th>Background</th>
      <th>Detailed To</th>
    </tr>
  </thead>
  <tbody>
{% assign wreckers_iter = wreckers | sort: "start_date"  %}
{% for pos in wreckers_iter  %}
{% find person in people, name == pos.name %}
  <tr>
    <td>{% render 'link_person', name: pos.name, pages: pages %}</td>
    <td>{{ pos.person.age }}</td>
    <td>{{ pos.start_date }}</td>
    <td>{% if pos.person.background %}{{ pos.person.background | titleize }}{% endif %}</td>
    <td>{{ person.positions | where: "type", "detailed" | map: "agency_id" | join: ", " }}</td>
  </tr>
{% endfor %}
  </tbody>
</table>