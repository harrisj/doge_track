<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
{% capture resource_title %}{{ title | strip_html | strip_newlines }}{% endcapture %}
<title>
  {% if resource_title != 'Index' -%}
    {{- resource_title | escape }} | {{ metadata.title | escape -}}
  {%- else -%}
    {{- metadata.title | escape }}: {{ metadata.tagline | escape -}}
  {%- endif %}
</title>

<meta name="description" content="{{ metadata.description }}">
<meta name="turbo-cache-control" content="no-preview">

<link rel="stylesheet" href="{% asset_path css %}">
<script src="{% asset_path js %}" defer></script>

<script src="https://kit.fontawesome.com/7511933f33.js" crossorigin="anonymous"></script>

{% live_reload_dev_js %}
