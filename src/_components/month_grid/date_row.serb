<!---- {{ @date }}  ----->
{% if any? %}
   <div class="flex flex-col font-sans divide-y-4 divide-gray-20">
     {%# MonthGrid::ExecutiveOrders orders: @executive_orders %}
     {%@ MonthGrid::StartPositions positions: @start_positions %}
     {%# MonthGrid::EndPositions positions: @end_positions %}
     {% @events.each do |event| %}
       {%@ MonthGrid::Event event: event %}
     {% end %}
   </div>
{% end %}
