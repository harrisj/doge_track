<div>{{ render EventLabel.new(@event.type, :icon) }}</div>
<div class="font-sans" id="{{ @event.id }}">
  {{ @event.linkified_text | raw }}
  {% if @event.fuzz %} <span class="italic">(fuzz: {%@ Atoms::Blurb @event.fuzz %})</span>{% end %}
  {% if false && @event.type == 'interagency' && (@event.people.any? || @event.doge_aliases.any?) %}
    {%@ 'molecules/event_directory_display', event: @event %}
  {% end %}
  {% if false && @event.type == 'directory' %}
    {%@ 'molecules/event_directory_display', event: @event %}
  {% end %}
  {% if false && @event.projects.any? %}
    {%@ 'molecules/event_projects_display', event: @event %}
  {% end %}
</div>
