<div class="collapse">
  <input type="checkbox"/>
    <div class="collapse-title grid grid-cols-[18px_auto] gap-x-1 p-0">
        <div>{{ render EventLabel.new(@event.type, :icon) }}</div>
        <div class="font-sans" id="{{ @event.id }}">
            {{ @event.linkified_text | raw }} <i class="fa-sharp fa-solid fa-museum"></i> {%@ Atoms::AgenciesList @event.agencies %}
            {% if false && @event.type == 'interagency' && (@event.people.any? || @event.doge_aliases.any?) %}
              {%@ 'molecules/event_directory_display', event: @event %} 
            {% end %}
            {% if false && @event.type == 'directory' %}
              {%@ 'molecules/event_directory_display', event: @event %}
            {% end %}
            {% if false && @event.projects.any? %}
              {%@ 'molecules/event_projects_display', event: @event %}
            {% end %}
        </div>
    </div>
    <div class="collapse-content grid grid-cols-[18px_auto] gap-x-1 ml-[25px] pt-1">
       {% if @event.fuzz %}
          <div "class="text-base-content/75 align-center"><i class="fa-sharp fa-solid fa-question"></i></div>
          <div class="italic">Fuzz: {%@ Atoms::Blurb @event.fuzz %}</div>
       {% end %}
       {% if @event.sources.any? %}
          {% @event.sources.each do |source| %}
          <div "class="text-base-content/75 align-center"><i class="fa-sharp fa-solid fa-receipt"></i></div>
          <div><a target="_blank" href="{{ source.url }}"><cite>{{ source.title }}</cite></a> <i class="fa-sharp fa-solid fa-up-right-from-square"></i> {{source.publisher.name}}, {% if source.pub_date %}{%@ Atoms::DateLabel source.pub_date %}{% end %}</div>
          {% end %}
       {% end %}
       {% if @event.people.any? %}
          <div class="text-base-content/75 align-center"><i class="fa-sharp fa-solid fa-person"></i></div>
          <div>{%@ Atoms::PeopleList @event.people %}</div>
       {% end %}
       {% if @event.projects.any? %}
           <div class="text-base-content/75 align-center"><i class="fa-sharp fa-solid fa-clipboard-check"></i></div>
           <div>{%@ Atoms::ProjectsList @event.projects %}</div>
       {% end %}
    </div>
</div>

