<div class="data-grid-title flex justify-between items-end">
  <h2>Positions</h2>
  {%@ Grid::Legend :positions %}
</div>

{% each_agency do |agency, positions| %}
   <div>{%@ Atoms::AgencyLink agency %}</div>
   <div class="">{%@ Grid::PersonPositionsAgency agency: agency, person: @person, positions: positions %}</div>
{% end %}
