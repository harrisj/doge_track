
  {% each_date do |rec| %}
     {% next unless rec.any? %}
     <div class="md:text-nowrap"><date>{{ rec.date.strftime("%a %-m/%d") }}</date></div>
     <div>{{ render rec }}</div>
  {% end %}

  {% if undated.any? %}
    <div><date>{{ @undated.date.strftime("%-m") }}/XX</date></div>
    <div>{{ render undated }}</div>
  {% end %}
