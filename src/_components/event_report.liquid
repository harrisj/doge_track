<article class="media">
  <div class="media-left">
    <span class="icon is-medium">
      {% if event.type == 'report' %}
        <i class="fa fa-2xl fa-binoculars"></i>
      {% elsif event.type == 'disruption' %}
        <i class="fa fa-2xl fa-explosion"></i>
      {% elsif event.type == 'official' %}
        <i class="fa-solid fa-2xl fa-landmark"></i>
      {% endif %}
    </span>
  </div>
  <div class="media-content">
    <div class="content">
      <div class="level mb-0 is-mobile">
        <div class="level-left is-flex-direction-row is-align-content-flex-start">
          <div class="level-item">
              {% if event.type == 'report' %}
                <strong>Sighting</strong>
              {% elsif event.type == 'disruption' %}
                <strong>Disruption</strong>
              {% elsif event.type == 'official' %}
                <strong>Official</strong>
              {% endif %}
          </div>
          <div class="level-item"><small>{{ event.date }}</small></div>
        </div>
    </div>
      <p class="is-size-6">{{ event.text }}</p>
    </div>
    <nav class="mb-0 is-mobile">
      <div class="level-left is-flex-direction-row is-align-content-flex-start is-flex-wrap-wrap">
        <div class="level-item"><span class="icon is-small"><i class="fas fa-building"></i></span><small class="ml-2">{{ event.agencies | map: "short_name" | join: ", " }}</small></div>
        {% if event.people != blank %} 
            {% for person in event.people %}
              <div class="level-item"><span class="icon is-small"><i class="fas fa-user"></i></span><small class="ml-2"><a href="/people/{{ person.slug }}">{{ person.name }}</a></small></div>
            {% endfor %}
        {% endif %}
        {% if event.source_name != blank %} 
          <div class="level-item">
            <span class="icon is-small"><i class="fas fa-newspaper"></i></span>
            <small class="ml-2"><a href="{{ event.source }}">{{ event.source_name }}</a></small>
          </div>
        {% endif %}
      </div>
    </nav>
  </div>
</article>