{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Connection between two DOGE people",
    "description": "Representing a connection between DOGE people",
    "properties": {
        "entity_id": {
            "$ref": "entity-id.json"
        },
        "before_doge": {
            "type": "boolean"
        },
        "after_doge": {
            "type": "boolean"
        },
        "during_doge": {
            "type": "boolean"
        },
        "source": {
            "$ref": "source-ref.json"
        },
        "description": {
            "type": "string"
        },
        "table_note": {
            "type": "string"
        },
        "start_date": {
            "$ref": "fuzzy_date.json"
        },
        "start_date_truth": {
            "$ref": "truth_type.json"
        },
        "end_date": {
            "$ref": "fuzzy_date.json"
        },
        "end_date_truth": {
            "$ref": "truth_type.json"
        },
        "connection_truth": {
            "$ref": "truth_type.json"
        }
    },
    "required": ["entity_id", "source", "connection_truth"],
    "dependentRequired": {
        "start_date": ["start_date_truth"],
        "end_date": ["end_date_truth"]
    },
    "additionalProperties": false
}
