{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Connection between two DOGE people",
    "description": "Representing a connection between DOGE people",
    "properties": {
        "entity_id": {
            "$ref": "entity-id.json"
        },
        "role": {
            "type": "string",
            "description": "The type of the relationship with the entity",
            "enum": [
                "consultant",
                "employee",
                "executive",
                "investor",
                "member",
                "ceo",
                "founder",
                "leader",
                "mentor",
                "mentee",
                "intern"
            ]
        },
        "timeframe": {
            "type": "string",
            "description": "When did this connection first start?",
            "enum": [
                "before",
                "after",
                "during",
                "unknown"
            ]
        },
        "immediate": {
            "type": "boolean",
            "description": "Was the role immediately before or after DOGE?"
        },
        "returned": {
            "type": "boolean",
            "description": "True if they've returned to the role after DOGE"
        },
        "source": {
            "$ref": "source-ref.json"
        },
        "description": {
            "type": "string"
        },
        "table_note": {
            "type": "string"
        },
        "start_date": {
            "$ref": "fuzzy_date.json"
        },
        "start_date_truth": {
            "$ref": "truth_type.json"
        },
        "end_date": {
            "$ref": "fuzzy_date.json"
        },
        "end_date_truth": {
            "$ref": "truth_type.json"
        },
        "connection_truth": {
            "$ref": "truth_type.json"
        }
    },
    "required": [
        "entity_id",
        "source",
        "connection_truth",
        "timeframe",
        "role"
    ],
    "dependentRequired": {
        "start_date": [
            "start_date_truth"
        ],
        "end_date": [
            "end_date_truth"
        ]
    },
    "additionalProperties": false
}
