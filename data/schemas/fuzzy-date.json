{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A date following the ISO 8601 standard for specific or imprecise dates",
  "$comment": "https://www.datafix.com.au/BASHing/2020-02-12.html",
  "type": "string",
  "pattern": "^(?:(?<date>\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?)(?<time>T(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:Z|[+-](?:[01]\\d|2[0-3]):[0-5]\\d)?)?|(?<season>\\d{4}-(?:2[1-9]|3\\d|40)))(?<qualifier>[?~%])?|(?<interval>(?:(?:\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?)|(?<open_start>))\\/(?:(?:\\d{4}(?:-(?:0[1-9]|1[0-2])(?:-(?:0[1-9]|[12]\\d|3[01]))?)?)|(?<open_end>)))$"
}
