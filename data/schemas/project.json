{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "properties": {
        "id": {
            "type": "string",
            "description": "A unique short identifier for the project",
            "$ref": "project-id.json"
        },
        "title": {
            "type": "string",
            "description": "A display title for this project"
        },
        "summary": {
            "type": "string",
            "description": "A brief summary of this project"
        },
        "path": {
            "type": "string",
            "description": "The path to the project page for it"
        },
        "label_text": {
            "type": "string",
            "description": "Text for a small label"
        },
        "label_color": {
            "type": "string"
        }
    },
    "required": [
        "id",
        "path",
        "title",
        "summary",
        "label_text"
    ],
    "additionalProperties": false
}
