{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "type": "object",
    "title": "Person",
    "description": "Information about a specific DOGE-affiliated person",
    "properties": {
        "name": {
            "description": "The name of the person. This is also their primary key",
            "$ref": "name.json"
        },
        "sort_name": {
            "description": "Usually the last name alone, but could include an initial in case of common names. Primarily used for sorting",
            "type": "string"
        },
        "slug": {
            "description": "A unique slug for use in URLs for this person",
            "type": "string",
            "pattern": "^[a-z\\-]+$"
        },
        "age": {
            "description": "What was their age in early 2025 when this all started",
            "type": "integer"
        },
        "own_page": {
            "description": "Do they have their own page?",
            "type": "boolean"
        },
        "blurb": {
            "description": "A blurb about the person to appear on their page",
            "type": "string"
        },
        "reporting_notes": {
            "description": "A text field for collecting any notes about the reporting on the person",
            "type": "string"
        },
        "table_note": {
            "description": "A very short note to display in tables about the person",
            "type": "string",
            "max_length": 30
        },
        "college_graduation_year": {
            "type": "integer",
            "patten": "[19|20]\\d\\d"
        },
        "custom_path": {
            "description": "A custom path for where the name should link to",
            "type": "string"
        },
        "govt_exit_type": {
            "description": "How they offboarded",
            "$ref": "end-type.json"
        },
        "govt_exit_date": {
            "description": "A date when they left DOGE entirely",
            "type": "string",
            "$ref": "fuzzy-date.json"
        },
        "govt_exit_truth": {
            "description": "Accuracy of the info",
            "$ref": "truth-type.json"
        },
        "source": {
            "$ref": "source-ref.json"
        },
        "skill": {
            "description": "What is their skill/role within DOGE?",
            "type": "string",
            "enum": [
                "lawyer",
                "strategic",
                "political",
                "designer",
                "administrator",
                "analyst",
                "coder",
                "executive",
                "recruiter"
            ]
        },
        "tech_links": {
            "description": "Links to any of the usual Musk/Thiel/Andreesen-linked companies",
            "type": "array",
            "items": {
                "type": "string",
                "enum": [
                    "Airbnb",
                    "Anduril",
                    "Andreessen Horowitz",
                    "Boring Co.",
                    "Human Capital",
                    "Neuralink",
                    "Musk family",
                    "Palantir",
                    "SpaceX",
                    "Special",
                    "Tesla",
                    "Twitter",
                    "Valor"
                ]
            }
        },
        "affiliations": {
            "type": "array",
            "items": {
                "$ref": "affiliation.json"
            }
        },
        "linkedin": {
            "description": "A likely LinkedIn url for a person (but remember it could be faked)",
            "type": "string"
        },
        "positions": {
            "type": "array",
            "items": {
                "$ref": "position.json"
            }
        }
    },
    "required": [
        "name",
        "sort_name"
    ],
    "dependentRequired": {
        "govt_exit_date": ["govt_exit_type", "govt_exit_truth"]
    },
    "additionalProperties": false
}
